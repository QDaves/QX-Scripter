<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:Double x:Key="Chat.LineMinHeight">44</x:Double>
  <x:Double x:Key="Chat.HeadWidth">28</x:Double>
  <Thickness x:Key="Chat.ListPadding">12,8,12,12</Thickness>
  <Thickness x:Key="Chat.LinePadding">12,7</Thickness>
  <Thickness x:Key="Chat.HeadMargin">0,1,0,0</Thickness>
  <Thickness x:Key="Chat.BodyMargin">10,0,12,0</Thickness>
  <Thickness x:Key="Chat.TimeMargin">0,1,0,0</Thickness>
  <Thickness x:Key="Chat.JumpMargin">0,0,0,16</Thickness>

  <ControlTheme x:Key="Chat.LineItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Setter Property="MinHeight" Value="{StaticResource Chat.LineMinHeight}" />
    <Setter Property="Padding" Value="{StaticResource Chat.LinePadding}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </ControlTheme>

</ResourceDictionary>
