<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <x:Double x:Key="Inventory.NumberWidth">84</x:Double>
  <x:Double x:Key="Inventory.IconSlotSize">36</x:Double>
  <x:Double x:Key="Inventory.TileImageWidth">64</x:Double>
  <x:Double x:Key="Inventory.TileImageHeight">56</x:Double>
  <x:Double x:Key="Inventory.SellDialogWidth">760</x:Double>
  <x:Double x:Key="Inventory.SellGridHeight">300</x:Double>
  <x:Double x:Key="Inventory.SellNumberWidth">84</x:Double>
  <x:Double x:Key="Inventory.SellNoteWidth">560</x:Double>
  <x:Double x:Key="Inventory.SellPriceWidth">72</x:Double>
  <x:Double x:Key="Inventory.SellAmountWidth">28</x:Double>

  <ControlTheme x:Key="Inventory.Tile" TargetType="ListBoxItem" BasedOn="{StaticResource QxTile}">
    <Setter Property="Width" Value="{DynamicResource QxTileInventorySize}" />
    <Setter Property="Height" Value="{DynamicResource QxTileInventorySize}" />
  </ControlTheme>

</ResourceDictionary>
