<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ControlTheme x:Key="Library.CommunityLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource QxAccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource QxAccentBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource QxFillSelectedHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QxAccentBrush}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="Library.RowItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Setter Property="Margin" Value="12,2" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="MinHeight" Value="68" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </ControlTheme>
  <ControlTheme x:Key="Library.FilterItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Setter Property="Margin" Value="8,2" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </ControlTheme>
  <ItemsPanelTemplate x:Key="Library.ListPanel">
    <VirtualizingStackPanel />
  </ItemsPanelTemplate>
</ResourceDictionary>
