<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Qx.Desktop.Controls">

  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource QxControlFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource QxTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QxBorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource QxRadiusSm}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="{DynamicResource QxControlHeightMd}" />
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeBody}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
              </Transitions>
            </Border.Transitions>
            <Panel>
              <Border Name="PART_State"
                      Background="Transparent"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      IsHitTestVisible="False" />
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Padding="{TemplateBinding Padding}"
                                RecognizesAccessKey="True"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Panel>
          </Border>
          <Border Name="PART_FocusRing"
                  Margin="{DynamicResource QxFocusRingMargin}"
                  BorderThickness="{DynamicResource QxFocusRingThickness}"
                  BorderBrush="{DynamicResource QxFocusRingBrush}"
                  CornerRadius="{DynamicResource QxRadiusFocusSm}"
                  IsHitTestVisible="False"
                  IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource QxBorderStrongBrush}" />
      <Style Selector="^ /template/ Border#PART_State">
        <Setter Property="Background" Value="{DynamicResource QxFillHoverBrush}" />
      </Style>
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_State">
      <Setter Property="Background" Value="{DynamicResource QxFillPressedBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource QxDisabledOpacity}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^.primary">
      <Setter Property="Background" Value="{DynamicResource QxAccentFillBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QxAccentFillBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource QxTextOnAccentBrush}" />
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource QxAccentFillHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QxAccentFillHoverBrush}" />
        <Style Selector="^ /template/ Border#PART_State">
          <Setter Property="Background" Value="Transparent" />
        </Style>
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource QxAccentFillPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QxAccentFillPressedBrush}" />
        <Style Selector="^ /template/ Border#PART_State">
          <Setter Property="Background" Value="Transparent" />
        </Style>
      </Style>
    </Style>

    <Style Selector="^.danger">
      <Setter Property="Background" Value="{DynamicResource QxDangerFillBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QxDangerFillBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource QxTextOnAccentBrush}" />
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource QxDangerFillHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QxDangerFillHoverBrush}" />
        <Style Selector="^ /template/ Border#PART_State">
          <Setter Property="Background" Value="Transparent" />
        </Style>
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource QxDangerFillPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QxDangerFillPressedBrush}" />
        <Style Selector="^ /template/ Border#PART_State">
          <Setter Property="Background" Value="Transparent" />
        </Style>
      </Style>
    </Style>

    <Style Selector="^.danger-outline">
      <Setter Property="Background" Value="{DynamicResource QxDangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource QxDangerBrush}" />
      <Style Selector="^:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource QxDangerBrush}" />
      </Style>
    </Style>

    <Style Selector="^.subtle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource QxTextSecondaryBrush}" />
      <Setter Property="Padding" Value="8,0" />
      <Style Selector="^:pointerover">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource QxTextPrimaryBrush}" />
      </Style>
    </Style>

    <Style Selector="^.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource QxTextSecondaryBrush}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="{DynamicResource QxControlHeightMd}" />
      <Setter Property="Height" Value="{DynamicResource QxControlHeightMd}" />
      <Setter Property="MinHeight" Value="0" />
      <Style Selector="^:pointerover">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource QxTextPrimaryBrush}" />
      </Style>
    </Style>

    <Style Selector="^.small">
      <Setter Property="MinHeight" Value="{DynamicResource QxControlHeightSm}" />
      <Setter Property="FontSize" Value="{DynamicResource QxFontSizeSmall}" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="^.icon.small">
      <Setter Property="Width" Value="{DynamicResource QxControlHeightSm}" />
      <Setter Property="Height" Value="{DynamicResource QxControlHeightSm}" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="^.large">
      <Setter Property="MinHeight" Value="{DynamicResource QxControlHeightLg}" />
      <Setter Property="Padding" Value="14,0" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type Button}}">
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource QxFillSelectedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource QxAccentBrush}" />
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource QxFillSelectedHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource QxAccentBrush}" />
        <Style Selector="^ /template/ Border#PART_State">
          <Setter Property="Background" Value="Transparent" />
        </Style>
      </Style>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type RepeatButton}" TargetType="RepeatButton" BasedOn="{StaticResource {x:Type Button}}" />

  <ControlTheme x:Key="QxLinkButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource QxAccentBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeBody}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="Center"
                            RecognizesAccessKey="True" />
          <Border Name="PART_FocusRing"
                  Margin="-4,-2"
                  BorderThickness="{DynamicResource QxFocusRingThickness}"
                  BorderBrush="{DynamicResource QxFocusRingBrush}"
                  CornerRadius="{DynamicResource QxRadiusSm}"
                  IsHitTestVisible="False"
                  IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource QxTextPrimaryBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource QxDisabledOpacity}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:CopyButton}" TargetType="c:CopyButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource QxTextSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource QxRadiusSm}" />
    <Setter Property="Width" Value="{DynamicResource QxControlHeightMd}" />
    <Setter Property="Height" Value="{DynamicResource QxControlHeightMd}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="ToolTip.Tip" Value="Copy" />
    <Setter Property="AutomationProperties.Name" Value="Copy" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
              </Transitions>
            </Border.Transitions>
            <Panel>
              <c:Icon Name="PART_CopyGlyph" Kind="Copy" Size="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <c:Icon Name="PART_CheckGlyph" Kind="Check" Size="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" Foreground="{DynamicResource QxSuccessBrush}" />
            </Panel>
          </Border>
          <Border Name="PART_FocusRing"
                  Margin="{DynamicResource QxFocusRingMargin}"
                  BorderThickness="{DynamicResource QxFocusRingThickness}"
                  BorderBrush="{DynamicResource QxFocusRingBrush}"
                  CornerRadius="{DynamicResource QxRadiusFocusSm}"
                  IsHitTestVisible="False"
                  IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource QxTextPrimaryBrush}" />
      <Style Selector="^ /template/ Border#PART_Root">
        <Setter Property="Background" Value="{DynamicResource QxFillHoverBrush}" />
      </Style>
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource QxFillPressedBrush}" />
    </Style>
    <Style Selector="^:copied">
      <Setter Property="ToolTip.Tip" Value="Copied" />
      <Style Selector="^ /template/ c|Icon#PART_CopyGlyph">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^ /template/ c|Icon#PART_CheckGlyph">
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource QxDisabledOpacity}" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="Width" Value="{DynamicResource QxControlHeightSm}" />
      <Setter Property="Height" Value="{DynamicResource QxControlHeightSm}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
