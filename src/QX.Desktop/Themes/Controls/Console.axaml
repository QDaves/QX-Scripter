<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Qx.Desktop.Controls"
                    xmlns:conv="using:Qx.Desktop.Converters">

  <conv:TimeText x:Key="QxTimeText" />

  <ControlTheme x:Key="{x:Type c:ConsoleLine}" TargetType="c:ConsoleLine">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Band" Background="Transparent" Padding="16,0" MinHeight="{DynamicResource QxConsoleLineHeight}">
          <Grid ColumnDefinitions="68,40,*">
            <TextBlock Text="{TemplateBinding Time}"
                       FontFamily="{DynamicResource QxMonoFont}"
                       FontSize="{DynamicResource QxFontSizeCodeSmall}"
                       LineHeight="{DynamicResource QxLineHeightCode}"
                       VerticalAlignment="Top"
                       Foreground="{DynamicResource QxTextTertiaryBrush}" />
            <TextBlock Name="PART_Level"
                       Grid.Column="1"
                       Text="{TemplateBinding LevelText}"
                       FontFamily="{DynamicResource QxMonoFont}"
                       FontSize="{DynamicResource QxFontSizeCodeCaption}"
                       FontWeight="Medium"
                       LineHeight="{DynamicResource QxLineHeightCode}"
                       VerticalAlignment="Top"
                       Foreground="{DynamicResource QxTextTertiaryBrush}" />
            <TextBlock Name="PART_Text"
                       Grid.Column="2"
                       Text="{TemplateBinding Text}"
                       FontFamily="{DynamicResource QxMonoFont}"
                       FontSize="{DynamicResource QxFontSizeCodeSmall}"
                       LineHeight="{DynamicResource QxLineHeightCode}"
                       VerticalAlignment="Top"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource QxEditorForegroundBrush}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:wrap /template/ TextBlock#PART_Text">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style Selector="^:warning">
      <Style Selector="^ /template/ Border#PART_Band">
        <Setter Property="Background" Value="{DynamicResource QxWarningBandBrush}" />
      </Style>
      <Style Selector="^ /template/ TextBlock#PART_Level">
        <Setter Property="Foreground" Value="{DynamicResource QxWarningBrush}" />
      </Style>
      <Style Selector="^ /template/ TextBlock#PART_Text">
        <Setter Property="Foreground" Value="{DynamicResource QxWarningBrush}" />
      </Style>
    </Style>
    <Style Selector="^:error">
      <Style Selector="^ /template/ Border#PART_Band">
        <Setter Property="Background" Value="{DynamicResource QxDangerBandBrush}" />
      </Style>
      <Style Selector="^ /template/ TextBlock#PART_Level">
        <Setter Property="Foreground" Value="{DynamicResource QxDangerBrush}" />
      </Style>
      <Style Selector="^ /template/ TextBlock#PART_Text">
        <Setter Property="Foreground" Value="{DynamicResource QxDangerBrush}" />
      </Style>
    </Style>
  </ControlTheme>

</ResourceDictionary>
