<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Qx.Desktop.Controls"
                    xmlns:conv="using:Qx.Desktop.Converters">

  <conv:KeyChordText x:Key="QxKeyChordText" />

  <ControlTheme x:Key="QxMenuScrollViewer" TargetType="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <ControlTemplate>
        <ScrollContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                Padding="{TemplateBinding Padding}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ContextMenu}" TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{DynamicResource QxSansFont}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Background" Value="{DynamicResource QxSurfaceOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QxBorderOverlayBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource QxRadiusMd}" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinWidth" Value="208" />
    <Setter Property="MaxWidth" Value="360" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="WindowManagerAddShadowHint" Value="False" />
    <Setter Property="HorizontalOffset" Value="-12" />
    <Setter Property="VerticalOffset" Value="-4" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Margin="{DynamicResource QxPopupShadowMargin}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource QxShadowPopup}"
                MinWidth="{TemplateBinding MinWidth}"
                MaxWidth="{TemplateBinding MaxWidth}"
                Padding="{TemplateBinding Padding}">
          <ScrollViewer Theme="{StaticResource QxMenuScrollViewer}">
            <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            KeyboardNavigation.TabNavigation="Continue"
                            Grid.IsSharedSizeScope="True" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type MenuFlyoutPresenter}" TargetType="MenuFlyoutPresenter">
    <Setter Property="FontFamily" Value="{DynamicResource QxSansFont}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Background" Value="{DynamicResource QxSurfaceOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QxBorderOverlayBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource QxRadiusMd}" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinWidth" Value="208" />
    <Setter Property="MaxWidth" Value="360" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Margin="{DynamicResource QxPopupShadowMargin}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource QxShadowPopup}"
                Padding="{TemplateBinding Padding}">
          <ScrollViewer Theme="{StaticResource QxMenuScrollViewer}">
            <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            KeyboardNavigation.TabNavigation="Continue"
                            Grid.IsSharedSizeScope="True" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type FlyoutPresenter}" TargetType="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource QxSurfaceOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QxBorderOverlayBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource QxRadiusMd}" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Margin="{DynamicResource QxPopupShadowMargin}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource QxShadowPopup}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type MenuItem}" TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource QxTextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeBody}" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="MinHeight" Value="{DynamicResource QxControlHeightMd}" />
    <Setter Property="CornerRadius" Value="{DynamicResource QxRadiusSm}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_LayoutRoot"
                  Padding="{TemplateBinding Padding}"
                  MinHeight="{TemplateBinding MinHeight}"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="QxMenuIcon" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="QxMenuGesture" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="QxMenuChevron" />
              </Grid.ColumnDefinitions>
              <Panel Name="PART_IconSlot" Grid.Column="0" Width="16" Margin="0,0,8,0" VerticalAlignment="Center">
                <ContentPresenter Name="PART_IconPresenter"
                                  Content="{TemplateBinding Icon}"
                                  Foreground="{DynamicResource QxTextSecondaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                <c:Icon Name="PART_CheckGlyph"
                        Kind="Check"
                        Size="14"
                        IsVisible="False"
                        Foreground="{DynamicResource QxAccentBrush}" />
              </Panel>
              <ContentPresenter Name="PART_HeaderPresenter"
                                Grid.Column="1"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
              <TextBlock Name="PART_InputGestureText"
                         Grid.Column="2"
                         Margin="24,0,0,0"
                         FontSize="{DynamicResource QxFontSizeSmall}"
                         Foreground="{DynamicResource QxTextTertiaryBrush}"
                         Text="{TemplateBinding InputGesture, Converter={StaticResource QxKeyChordText}}"
                         VerticalAlignment="Center" />
              <c:Icon Name="PART_ChevronPath"
                      Grid.Column="3"
                      Kind="ChevronRight"
                      Size="14"
                      Margin="12,0,0,0"
                      Foreground="{DynamicResource QxTextTertiaryBrush}"
                      VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Popup Name="PART_Popup"
                 WindowManagerAddShadowHint="False"
                 Placement="RightEdgeAlignedTop"
                 HorizontalOffset="-4"
                 VerticalOffset="-9"
                 IsLightDismissEnabled="False"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}">
            <Border Margin="{DynamicResource QxPopupShadowMargin}"
                    Background="{DynamicResource QxSurfaceOverlayBrush}"
                    BorderBrush="{DynamicResource QxBorderOverlayBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource QxRadiusMd}"
                    BoxShadow="{DynamicResource QxShadowPopup}"
                    Padding="6"
                    MinWidth="180"
                    MaxWidth="360">
              <ScrollViewer Theme="{StaticResource QxMenuScrollViewer}">
                <ItemsPresenter Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}"
                                Grid.IsSharedSizeScope="True" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:not(:icon):not(:toggle) /template/ Panel#PART_IconSlot">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:checked /template/ c|Icon#PART_CheckGlyph">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:empty /template/ c|Icon#PART_ChevronPath">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource QxFillHoverBrush}" />
    </Style>
    <Style Selector="^:selected /template/ ContentPresenter#PART_IconPresenter">
      <Setter Property="Foreground" Value="{DynamicResource QxTextPrimaryBrush}" />
    </Style>
    <Style Selector="^:open /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource QxFillHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource QxFillPressedBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource QxDisabledOpacity}" />
    </Style>
    <Style Selector="^.danger">
      <Setter Property="Foreground" Value="{DynamicResource QxDangerBrush}" />
      <Style Selector="^ /template/ ContentPresenter#PART_IconPresenter">
        <Setter Property="Foreground" Value="{DynamicResource QxDangerBrush}" />
      </Style>
    </Style>
    <Style Selector="^:separator">
      <Setter Property="Template">
        <ControlTemplate>
          <Separator Margin="6,5" />
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <Setter Property="Background" Value="{DynamicResource QxBorderOverlayBrush}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="6,5" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource QxTextOnInverseBrush}" />
    <Setter Property="Background" Value="{DynamicResource QxSurfaceInverseBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeSmall}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="CornerRadius" Value="{DynamicResource QxRadiusSm}" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_LayoutRoot"
                Margin="8,4,8,12"
                Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource QxShadowPopup}">
          <ContentPresenter Name="PART_ContentPresenter"
                            MaxWidth="{TemplateBinding MaxWidth}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            TextBlock.TextWrapping="Wrap" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:open">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ComboBox}" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource QxTextPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource QxFieldBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QxBorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource QxRadiusSm}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource QxTextTertiaryBrush}" />
    <Setter Property="Padding" Value="8,0,28,0" />
    <Setter Property="MinHeight" Value="{DynamicResource QxControlHeightMd}" />
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeBody}" />
    <Setter Property="MaxDropDownHeight" Value="320" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <ControlTemplate>
        <DataValidationErrors>
          <Panel>
            <Border Name="Background"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MinHeight="{TemplateBinding MinHeight}" />
            <TextBlock Name="PlaceholderTextBlock"
                       Margin="{TemplateBinding Padding}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Text="{TemplateBinding PlaceholderText}"
                       Foreground="{TemplateBinding PlaceholderForeground}"
                       IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}" />
            <ContentControl Name="ContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <c:Icon Name="DropDownGlyph"
                    Kind="ChevronDown"
                    Size="14"
                    Margin="0,0,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Foreground="{DynamicResource QxTextTertiaryBrush}" />
            <Popup Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   MaxHeight="{TemplateBinding MaxDropDownHeight}"
                   PlacementTarget="Background"
                   HorizontalOffset="-12"
                   VerticalOffset="0"
                   IsLightDismissEnabled="True"
                   InheritsTransform="True">
              <Border Name="PopupBorder"
                      Width="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                      Margin="{DynamicResource QxPopupShadowMargin}"
                      Background="{DynamicResource QxSurfaceOverlayBrush}"
                      BorderBrush="{DynamicResource QxBorderOverlayBrush}"
                      BorderThickness="1"
                      Padding="4"
                      CornerRadius="{DynamicResource QxRadiusMd}"
                      BoxShadow="{DynamicResource QxShadowPopup}">
                <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                              IsScrollChainingEnabled="False">
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Panel>
        </DataValidationErrors>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.wide-popup /template/ Border#PopupBorder">
      <Setter Property="MinWidth" Value="300" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource QxBorderStrongBrush}" />
      <Setter Property="Background" Value="{DynamicResource QxFieldHoverBrush}" />
    </Style>
    <Style Selector="^:dropdownopen /template/ Border#Background, ^:focus-visible /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource QxAccentBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource QxFocusGlow}" />
    </Style>
    <Style Selector="^:error /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource QxDangerBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource QxDisabledOpacity}" />
    </Style>
    <Style Selector="^.small">
      <Setter Property="MinHeight" Value="{DynamicResource QxControlHeightSm}" />
      <Setter Property="FontSize" Value="{DynamicResource QxFontSizeSmall}" />
      <Setter Property="Padding" Value="6,0,24,0" />
    </Style>
    <Style Selector="^.subtle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ComboBoxItem}" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource QxTextPrimaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="{DynamicResource QxControlHeightMd}" />
    <Setter Property="CornerRadius" Value="{DynamicResource QxRadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                MinHeight="{TemplateBinding MinHeight}"
                Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="*,Auto">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <c:Icon Name="PART_Check"
                    Grid.Column="1"
                    Kind="Check"
                    Size="14"
                    Margin="12,0,0,0"
                    IsVisible="False"
                    Foreground="{DynamicResource QxAccentBrush}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource QxFillHoverBrush}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_Root">
      <Setter Property="Background" Value="{DynamicResource QxFillPressedBrush}" />
    </Style>
    <Style Selector="^:selected /template/ c|Icon#PART_Check">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource QxDisabledOpacity}" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
