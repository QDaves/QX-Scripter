<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="using:Qx.Desktop.Controls">

  <ControlTheme x:Key="QxRailGroup" TargetType="ItemsControl" BasedOn="{StaticResource {x:Type ItemsControl}}">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="QxRailItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource QxTextTertiaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="{DynamicResource QxRailWidth}" />
    <Setter Property="Height" Value="36" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="PART_Plate"
                  Width="36"
                  Height="36"
                  HorizontalAlignment="Center"
                  CornerRadius="{DynamicResource QxRadiusMd}"
                  Background="{TemplateBinding Background}">
            <ContentPresenter Name="PART_ContentPresenter"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Content="{TemplateBinding Content}" />
          </Border>
          <Border Name="PART_FocusRing"
                  Width="40"
                  Height="40"
                  Margin="-2"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  BorderThickness="{DynamicResource QxFocusRingThickness}"
                  BorderBrush="{DynamicResource QxFocusRingBrush}"
                  CornerRadius="{DynamicResource QxRadiusLg}"
                  IsHitTestVisible="False"
                  IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource QxTextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource QxFillHoverBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource QxFillPressedBrush}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource QxAccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource QxFillSelectedBrush}" />
    </Style>
    <Style Selector="^:checked:pointerover">
      <Setter Property="Background" Value="{DynamicResource QxFillSelectedHoverBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource QxDisabledOpacity}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="QxRailAction" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource QxTextTertiaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="{DynamicResource QxRailWidth}" />
    <Setter Property="Height" Value="36" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="PART_Plate"
                  Width="36"
                  Height="36"
                  HorizontalAlignment="Center"
                  CornerRadius="{DynamicResource QxRadiusMd}"
                  Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
          </Border>
          <Border Name="PART_FocusRing"
                  Width="40"
                  Height="40"
                  Margin="-2"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  BorderThickness="{DynamicResource QxFocusRingThickness}"
                  BorderBrush="{DynamicResource QxFocusRingBrush}"
                  CornerRadius="{DynamicResource QxRadiusLg}"
                  IsHitTestVisible="False"
                  IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource QxTextPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource QxFillHoverBrush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource QxFillPressedBrush}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource QxDisabledOpacity}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="QxCommandTrigger" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource QxTextTertiaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource QxFillSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QxBorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource QxRadiusMd}" />
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeSmall}" />
    <Setter Property="Width" Value="{DynamicResource QxCommandTriggerWidth}" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="8,0,4,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              Content="{TemplateBinding Content}" />
          </Border>
          <Border Name="PART_FocusRing"
                  Margin="{DynamicResource QxFocusRingMargin}"
                  BorderThickness="{DynamicResource QxFocusRingThickness}"
                  BorderBrush="{DynamicResource QxFocusRingBrush}"
                  CornerRadius="{DynamicResource QxRadiusFocusMd}"
                  IsHitTestVisible="False"
                  IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource QxFillHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QxBorderDefaultBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource QxTextSecondaryBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type c:StatusBarItem}" TargetType="c:StatusBarItem">
    <Setter Property="Foreground" Value="{DynamicResource QxTextSecondaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeSmall}" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource QxRadiusXs}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <c:Icon Name="PART_Icon" Kind="{TemplateBinding Icon}" Size="14" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" IsVisible="False" />
              <TextBlock Text="{TemplateBinding Label}"
                         VerticalAlignment="Center"
                         LineHeight="{DynamicResource QxLineHeightSmall}"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="220" />
              <TextBlock Name="PART_Detail"
                         Text="{TemplateBinding Detail}"
                         VerticalAlignment="Center"
                         LineHeight="{DynamicResource QxLineHeightSmall}"
                         FontFamily="{DynamicResource QxMonoFont}"
                         FontSize="{DynamicResource QxFontSizeCodeCaption}"
                         Foreground="{DynamicResource QxTextTertiaryBrush}"
                         IsVisible="False" />
            </StackPanel>
          </Border>
          <Border Name="PART_FocusRing"
                  Margin="-2"
                  BorderThickness="{DynamicResource QxFocusRingThickness}"
                  BorderBrush="{DynamicResource QxFocusRingBrush}"
                  CornerRadius="5"
                  IsHitTestVisible="False"
                  IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:not(:actionable)">
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="^:actionable:pointerover">
      <Setter Property="Background" Value="{DynamicResource QxFillHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource QxTextPrimaryBrush}" />
    </Style>
    <Style Selector="^:actionable:pressed">
      <Setter Property="Background" Value="{DynamicResource QxFillPressedBrush}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:icon /template/ c|Icon#PART_Icon">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:detail /template/ TextBlock#PART_Detail">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^.connection:not(:muted)">
      <Setter Property="Foreground" Value="{DynamicResource QxSuccessBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^:muted">
      <Setter Property="Foreground" Value="{DynamicResource QxTextTertiaryBrush}" />
    </Style>
    <Style Selector="^.count">
      <Setter Property="Padding" Value="4,0" />
    </Style>
  </ControlTheme>

</ResourceDictionary>
