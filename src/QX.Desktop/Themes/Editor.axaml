<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="clr-namespace:AvaloniaEdit.CodeCompletion;assembly=AvaloniaEdit"
        xmlns:editing="clr-namespace:AvaloniaEdit.Editing;assembly=AvaloniaEdit"
        xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit">

  <Style Selector="ae|TextEditor.script">
    <Setter Property="Background" Value="{DynamicResource QxEditorBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource QxEditorForegroundBrush}" />
    <Setter Property="LineNumbersForeground" Value="{DynamicResource QxEditorLineNumberBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource QxMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeCode}" />
    <Setter Property="Padding" Value="0,10,12,10" />
  </Style>

  <Style Selector="ae|TextEditor.script editing|TextArea">
    <Setter Property="SelectionBrush" Value="{DynamicResource QxEditorSelectionBrush}" />
    <Setter Property="SelectionForeground" Value="{x:Null}" />
  </Style>

  <Style Selector="cc|CompletionList">
    <Setter Property="Template">
      <ControlTemplate>
        <cc:CompletionListBox Name="PART_ListBox" FontSize="{DynamicResource QxFontSizeSmall}">
          <cc:CompletionListBox.ItemTemplate>
            <DataTemplate x:DataType="cc:ICompletionData">
              <StackPanel Orientation="Horizontal" Spacing="6" Height="24">
                <Image Source="{Binding Image}" Width="16" Height="16" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Content}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </cc:CompletionListBox.ItemTemplate>
        </cc:CompletionListBox>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="cc|CompletionListBox">
    <Setter Property="Background" Value="{DynamicResource QxSurfaceOverlayBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource QxBorderOverlayBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource QxRadiusMd}" />
    <Setter Property="Padding" Value="4" />
  </Style>

</Styles>
