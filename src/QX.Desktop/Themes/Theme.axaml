        <ResourceInclude Source="avares://QX/Themes/Areas/ApiBrowser.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Areas/CommandPalette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <FluentTheme>
    <FluentTheme.Palettes>
      <ColorPaletteResources x:Key="Light" Accent="#FF5B4BD6" RegionColor="#FFFFFFFF" ErrorText="#FFB42D32" BaseHigh="#FF16181D" AltHigh="#FFFFFFFF" ChromeMediumLow="#FFF3F4F7" />
      <ColorPaletteResources x:Key="Dark" Accent="#FF6E5EE6" RegionColor="#FF15171C" ErrorText="#FFF47F7F" BaseHigh="#FFE8EAF0" AltHigh="#FF15171C" ChromeMediumLow="#FF101216" />
    </FluentTheme.Palettes>
  </FluentTheme>
  <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
  <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
  <StyleInclude Source="avares://QX/Themes/Typography.axaml" />
  <StyleInclude Source="avares://QX/Themes/Classes.axaml" />
  <StyleInclude Source="avares://QX/Themes/Editor.axaml" />

</Styles>
