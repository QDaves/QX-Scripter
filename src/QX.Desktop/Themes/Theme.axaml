<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://QX/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Icons.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Brand.axaml" />
        <ResourceInclude Source="avares://QX/Themes/WindowDecorations.axaml" />
        <ResourceInclude Source="avares://QX/Themes/DataGrid.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Controls/Window.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Controls/Buttons.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Controls/Inputs.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Controls/Popups.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Controls/Selection.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Controls/Tabs.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Controls/Lists.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Controls/Badges.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Controls/Page.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Controls/Overlays.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Controls/RunButton.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Controls/Shell.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Controls/Media.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Controls/Console.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Areas/Library.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Areas/Log.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Areas/Room.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Areas/General.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Areas/Chat.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Areas/Friends.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Areas/Navigator.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Areas/Inventory.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Areas/Wardrobe.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Areas/GameCatalog.axaml" />
        <ResourceInclude Source="avares://QX/Themes/Areas/Settings.axaml" />
