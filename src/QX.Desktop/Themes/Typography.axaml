<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Qx.Desktop.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="QxSansFont">fonts:Qx#Inter, $Default</FontFamily>
      <FontFamily x:Key="QxMonoFont">fonts:Qx#JetBrains Mono NL, $Default</FontFamily>
      <FontFamily x:Key="ContentControlThemeFontFamily">fonts:Qx#Inter, $Default</FontFamily>
      <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>

      <x:Double x:Key="QxFontSizeDisplay">22</x:Double>
      <x:Double x:Key="QxFontSizeTitle">15</x:Double>
      <x:Double x:Key="QxFontSizeBody">13</x:Double>
      <x:Double x:Key="QxFontSizeSmall">12</x:Double>
      <x:Double x:Key="QxFontSizeCaption">11</x:Double>
      <x:Double x:Key="QxFontSizeCode">13</x:Double>
      <x:Double x:Key="QxFontSizeCodeSmall">12</x:Double>
      <x:Double x:Key="QxFontSizeCodeCaption">11</x:Double>

      <x:Double x:Key="QxLineHeightDisplay">28</x:Double>
      <x:Double x:Key="QxLineHeightTitle">20</x:Double>
      <x:Double x:Key="QxLineHeightBody">18</x:Double>
      <x:Double x:Key="QxLineHeightSmall">16</x:Double>
      <x:Double x:Key="QxLineHeightCaption">14</x:Double>
      <x:Double x:Key="QxLineHeightCode">20</x:Double>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeDisplay}" />
    <Setter Property="LineHeight" Value="{DynamicResource QxLineHeightDisplay}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.3" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeTitle}" />
    <Setter Property="LineHeight" Value="{DynamicResource QxLineHeightTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeBody}" />
    <Setter Property="LineHeight" Value="{DynamicResource QxLineHeightBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeBody}" />
    <Setter Property="LineHeight" Value="{DynamicResource QxLineHeightBody}" />
  </Style>
  <Style Selector="TextBlock.strong">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeSmall}" />
    <Setter Property="LineHeight" Value="{DynamicResource QxLineHeightSmall}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeCaption}" />
    <Setter Property="LineHeight" Value="{DynamicResource QxLineHeightCaption}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource QxMonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeCodeSmall}" />
  </Style>
  <Style Selector="TextBlock.mono.caption">
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeCodeCaption}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeSmall}" />
    <Setter Property="LineHeight" Value="{DynamicResource QxLineHeightSmall}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource QxTextSecondaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="TextBlock.helper">
    <Setter Property="FontSize" Value="{DynamicResource QxFontSizeSmall}" />
    <Setter Property="LineHeight" Value="{DynamicResource QxLineHeightSmall}" />
    <Setter Property="Foreground" Value="{DynamicResource QxTextTertiaryBrush}" />
    <Setter Property="Margin" Value="0,6,0,0" />
  </Style>

  <Style Selector="TextBlock.primary">
    <Setter Property="Foreground" Value="{DynamicResource QxTextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource QxTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource QxTextTertiaryBrush}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource QxAccentBrush}" />
  </Style>
  <Style Selector="TextBlock.running">
    <Setter Property="Foreground" Value="{DynamicResource QxRunningBrush}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource QxSuccessBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource QxWarningBrush}" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource QxDangerBrush}" />
  </Style>
  <Style Selector="TextBlock.info">
    <Setter Property="Foreground" Value="{DynamicResource QxInfoBrush}" />
  </Style>

  <Style Selector="c|Icon.primary">
    <Setter Property="Foreground" Value="{DynamicResource QxTextPrimaryBrush}" />
  </Style>
  <Style Selector="c|Icon.secondary">
    <Setter Property="Foreground" Value="{DynamicResource QxTextSecondaryBrush}" />
  </Style>
  <Style Selector="c|Icon.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource QxTextTertiaryBrush}" />
  </Style>
  <Style Selector="c|Icon.accent">
    <Setter Property="Foreground" Value="{DynamicResource QxAccentBrush}" />
  </Style>
  <Style Selector="c|Icon.running">
    <Setter Property="Foreground" Value="{DynamicResource QxRunningBrush}" />
  </Style>
  <Style Selector="c|Icon.success">
    <Setter Property="Foreground" Value="{DynamicResource QxSuccessBrush}" />
  </Style>
  <Style Selector="c|Icon.warning">
    <Setter Property="Foreground" Value="{DynamicResource QxWarningBrush}" />
  </Style>
  <Style Selector="c|Icon.danger">
    <Setter Property="Foreground" Value="{DynamicResource QxDangerBrush}" />
  </Style>
  <Style Selector="c|Icon.info">
    <Setter Property="Foreground" Value="{DynamicResource QxInfoBrush}" />
  </Style>

  <Style Selector="c|Spinner">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform">
      <RotateTransform />
    </Setter>
    <Style.Animations>
      <Animation Duration="0:0:0.8" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="c|Spinner.running">
    <Setter Property="Foreground" Value="{DynamicResource QxRunningBrush}" />
  </Style>
  <Style Selector="c|Spinner.warning">
    <Setter Property="Foreground" Value="{DynamicResource QxWarningBrush}" />
  </Style>
  <Style Selector="c|Spinner.secondary">
    <Setter Property="Foreground" Value="{DynamicResource QxTextSecondaryBrush}" />
  </Style>
  <Style Selector="c|Spinner.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource QxTextTertiaryBrush}" />
  </Style>

</Styles>
