<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Qx.Desktop.Controls"
             xmlns:d="using:Qx.Presentation.Dialogs"
             x:Class="Qx.Desktop.Views.Dialogs.PromptDialogView"
             x:DataType="d:PromptDialogViewModel">
  <c:Dialog CloseCommand="{Binding CancelCommand}"
            Width="{DynamicResource QxDialogWidthPrompt}"
            Title="{Binding Title}"
            Icon="{Binding Icon}"
            Tone="{Binding Tone}"
            Caption="{Binding Caption}">
    <TextBox Name="Value"
             Text="{Binding Text, Mode=TwoWay}"
             PlaceholderText="{Binding Placeholder}"
             AutomationProperties.Name="{Binding Placeholder}" />
    <c:Dialog.Buttons>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="large" MinWidth="88" Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
        <Button Classes="large primary"
                MinWidth="88"
                IsDefault="True"
                Content="{Binding AcceptText}"
                Command="{Binding AcceptCommand}" />
      </StackPanel>
    </c:Dialog.Buttons>
  </c:Dialog>
</UserControl>
