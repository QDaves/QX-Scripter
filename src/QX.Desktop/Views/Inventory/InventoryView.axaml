<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="using:Qx.Desktop.Behaviors"
             xmlns:c="using:Qx.Desktop.Controls"
             xmlns:vm="using:Qx.Presentation.ViewModels.Inventory"
             x:Class="Qx.Desktop.Views.Inventory.InventoryView"
             x:DataType="vm:InventoryViewModel">
  <c:PageLayout Page="{Binding}"
                CountText="{Binding CountText}"
                Notices="{Binding Notices}"
                Progress="{Binding Progress}">
    <c:PageLayout.Toolbar>
      <StackPanel>
        <c:FilterBar BorderBrush="{DynamicResource QxBorderSubtleBrush}" BorderThickness="0,0,0,1">
          <c:FilterBar.Search>
            <c:SearchBox Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="Search your inventory"
                         AutomationProperties.Name="Search your inventory" />
          </c:FilterBar.Search>
          <c:FilterBar.Filters>
            <StackPanel Orientation="Horizontal" Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Show" Classes="small tertiary" VerticalAlignment="Center" />
                <c:SegmentedControl SelectedIndex="{Binding KindIndex, Mode=TwoWay}" AutomationProperties.Name="Show">
                  <ListBoxItem AutomationProperties.Name="Show everything">
                    <c:Segment Text="All" />
                  </ListBoxItem>
                  <ListBoxItem AutomationProperties.Name="Show floor furni only">
                    <c:Segment Text="Floor" />
                  </ListBoxItem>
                  <ListBoxItem AutomationProperties.Name="Show wall furni only">
                    <c:Segment Text="Wall" />
                  </ListBoxItem>
                  <ListBoxItem AutomationProperties.Name="Show pets only">
                    <c:Segment Text="Pets" />
                  </ListBoxItem>
                </c:SegmentedControl>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Trade" Classes="small tertiary" VerticalAlignment="Center" />
                <c:SegmentedControl SelectedIndex="{Binding TradeIndex, Mode=TwoWay}" AutomationProperties.Name="Trade">
                  <ListBoxItem AutomationProperties.Name="Tradeable or not">
                    <c:Segment Text="Any" />
                  </ListBoxItem>
                  <ListBoxItem AutomationProperties.Name="Show only what may change hands">
                    <c:Segment Text="Tradeable" />
                  </ListBoxItem>
                  <ListBoxItem AutomationProperties.Name="Show only what may not change hands">
                    <c:Segment Text="Locked" />
                  </ListBoxItem>
                </c:SegmentedControl>
              </StackPanel>
            </StackPanel>
          </c:FilterBar.Filters>
          <c:FilterBar.Trailing>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Command="{Binding ReloadCommand}"
                      ToolTip.Tip="Ask the hotel for the inventory again"
                      AutomationProperties.Name="Reload">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:Icon Kind="Refresh" Size="14" />
                  <TextBlock Text="Reload" />
                </StackPanel>
              </Button>
              <Rectangle Classes="divider-vertical" />
              <c:SegmentedControl SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" AutomationProperties.Name="View">
                <ListBoxItem ToolTip.Tip="List" AutomationProperties.Name="List view">
                  <c:Segment Icon="ViewList" />
                </ListBoxItem>
                <ListBoxItem ToolTip.Tip="Grid" AutomationProperties.Name="Grid view">
                  <c:Segment Icon="ViewGrid" />
                </ListBoxItem>
              </c:SegmentedControl>
            </StackPanel>
          </c:FilterBar.Trailing>
        </c:FilterBar>
        <c:FilterBar>
          <c:FilterBar.Filters>
            <StackPanel Orientation="Horizontal" Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Owned" Classes="small tertiary" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding LeastOwned, Mode=TwoWay}"
                               Classes="mono"
                               Width="{DynamicResource Inventory.NumberWidth}"
                               Minimum="0"
                               Increment="1"
                               FormatString="0"
                               ShowButtonSpinner="False"
                               PlaceholderText="any"
                               ToolTip.Tip="Fewest copies to show"
                               AutomationProperties.Name="Fewest copies to show" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Price" Classes="small tertiary" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding LeastPrice, Mode=TwoWay}"
                               Classes="mono"
                               Width="{DynamicResource Inventory.NumberWidth}"
                               Minimum="0"
                               Increment="1"
                               FormatString="0"
                               ShowButtonSpinner="False"
                               PlaceholderText="from"
                               ToolTip.Tip="Cheapest price to show"
                               AutomationProperties.Name="Cheapest price to show" />
                <TextBlock Text="to" Classes="small tertiary" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding MostPrice, Mode=TwoWay}"
                               Classes="mono"
                               Width="{DynamicResource Inventory.NumberWidth}"
                               Minimum="0"
                               Increment="1"
                               FormatString="0"
                               ShowButtonSpinner="False"
                               PlaceholderText="up to"
                               ToolTip.Tip="Dearest price to show"
                               AutomationProperties.Name="Dearest price to show" />
              </StackPanel>
              <Button Classes="subtle small"
                      Content="Clear"
                      IsVisible="{Binding IsFiltering}"
                      Command="{Binding ClearFiltersCommand}"
                      ToolTip.Tip="Put every filter back to showing everything"
                      AutomationProperties.Name="Clear filters" />
            </StackPanel>
          </c:FilterBar.Filters>
        </c:FilterBar>
      </StackPanel>
    </c:PageLayout.Toolbar>
    <Panel>
      <DataGrid Name="Rows"
                ItemsSource="{Binding Rows}"
                IsVisible="{Binding IsListView}"
                RowHeight="{DynamicResource QxRowHeightLarge}"
                SelectionMode="Extended"
                CanUserReorderColumns="True"
                b:ListBehaviors.Selection="{Binding Selection}"
                b:ListBehaviors.SortRefresh="{Binding SortRefresh}"
                b:ListBehaviors.VisibleSink="{Binding}"
                b:ListBehaviors.CopyCommand="{Binding CopySelectionCommand}"
                AutomationProperties.Name="Your inventory">
        <DataGrid.Styles>
          <Style Selector="DataGridRow:selected /template/ Rectangle#SelectionMarker">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </DataGrid.Styles>
        <DataGrid.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Sell on marketplace"
                      IsVisible="{Binding CanSellSelection}"
                      Command="{Binding SellCommand}">
              <MenuItem.Icon>
                <c:Icon Kind="Tag" Size="16" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator IsVisible="{Binding CanSellSelection}" />
            <MenuItem Header="Copy identifier" Command="{Binding CopyIdentifierCommand}">
              <MenuItem.Icon>
                <c:Icon Kind="Copy" Size="16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy item id" Command="{Binding CopyItemIdCommand}">
              <MenuItem.Icon>
                <c:Icon Kind="Id" Size="16" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <c:DataGridGutterColumn x:DataType="vm:InventoryRowViewModel" />
          <DataGridTemplateColumn x:DataType="vm:InventoryRowViewModel"
                                  Header=""
                                  Width="52"
                                  MinWidth="52"
                                  CanUserSort="False"
                                  CanUserResize="False"
                                  CanUserReorder="False">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:InventoryRowViewModel">
                <Panel Width="{DynamicResource Inventory.IconSlotSize}" Height="{DynamicResource Inventory.IconSlotSize}">
                  <c:Icon Kind="{Binding Fallback}"
                          Size="16"
                          Classes="tertiary"
                          IsVisible="{Binding !HasImage}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                  <c:RemoteImage Request="{Binding Image}"
                                 Stretch="Uniform"
                                 StretchDirection="DownOnly"
                                 MaxWidth="{DynamicResource Inventory.IconSlotSize}"
                                 MaxHeight="{DynamicResource Inventory.IconSlotSize}" />
                </Panel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn x:DataType="vm:InventoryRowViewModel" Header="Name" Width="2*" SortMemberPath="Name">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:InventoryRowViewModel">
                <TextBlock Text="{Binding Name}" Classes="strong" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn x:DataType="vm:InventoryRowViewModel" Header="Identifier" Width="2*" SortMemberPath="Detail">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:InventoryRowViewModel">
                <TextBlock Text="{Binding Detail}"
                           Classes="mono secondary"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Detail}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn x:DataType="vm:InventoryRowViewModel" Header="Kind" Width="90" SortMemberPath="Group">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:InventoryRowViewModel">
                <TextBlock Text="{Binding GroupText}" Classes="secondary" Margin="12,0" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn x:DataType="vm:InventoryRowViewModel" Header="Owned" Width="80" SortMemberPath="Count">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:InventoryRowViewModel">
                <TextBlock Text="{Binding OwnedText}" Classes="mono secondary" Margin="12,0" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn x:DataType="vm:InventoryRowViewModel" Header="Market" Width="110" SortMemberPath="MarketValue">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:InventoryRowViewModel">
                <TextBlock Text="{Binding MarketText}" Classes="mono secondary" Margin="12,0" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn x:DataType="vm:InventoryRowViewModel" Header="Item id" Width="*" SortMemberPath="KeySort">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:InventoryRowViewModel">
                <TextBlock Text="{Binding KeyText}" Classes="mono tertiary" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <c:DataGridGutterColumn x:DataType="vm:InventoryRowViewModel" />
        </DataGrid.Columns>
      </DataGrid>
      <ListBox Name="Tiles"
               ItemsSource="{Binding Rows}"
               IsVisible="{Binding IsGridView}"
               Padding="12,8,12,12"
               SelectionMode="Multiple"
               ItemContainerTheme="{StaticResource Inventory.Tile}"
               b:ListBehaviors.Selection="{Binding Selection}"
               b:ListBehaviors.VisibleSink="{Binding}"
               b:ListBehaviors.CopyCommand="{Binding CopySelectionCommand}"
               AutomationProperties.Name="Your inventory, by kind">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Sell on marketplace"
                      IsVisible="{Binding CanSellSelection}"
                      Command="{Binding SellCommand}">
              <MenuItem.Icon>
                <c:Icon Kind="Tag" Size="16" />
              </MenuItem.Icon>
            </MenuItem>
            <Separator IsVisible="{Binding CanSellSelection}" />
            <MenuItem Header="Copy identifier" Command="{Binding CopyIdentifierCommand}">
              <MenuItem.Icon>
                <c:Icon Kind="Copy" Size="16" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy item id" Command="{Binding CopyItemIdCommand}">
              <MenuItem.Icon>
                <c:Icon Kind="Id" Size="16" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <c:UniformTilePanel ItemWidth="{DynamicResource QxTileInventoryPitch}" ItemHeight="{DynamicResource QxTileInventoryPitch}" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:InventoryRowViewModel">
            <Panel ToolTip.Tip="{Binding Tooltip}">
              <c:Icon Kind="{Binding Fallback}"
                      Size="20"
                      Classes="tertiary"
                      IsVisible="{Binding !HasImage}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
              <c:ItemTile Image="{Binding Image}"
                          Count="{Binding Count}"
                          Badge="{Binding MarketText}"
                          ImageMaxWidth="{DynamicResource Inventory.TileImageWidth}"
                          ImageMaxHeight="{DynamicResource Inventory.TileImageHeight}" />
            </Panel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </c:PageLayout>
</UserControl>
