<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Qx.Desktop.Controls"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:vm="using:Qx.Presentation.ViewModels.Library"
             xmlns:m="using:Qx.Presentation.Services.Library"
             x:Class="Qx.Desktop.Views.Library.CommunityView"
             x:DataType="vm:CommunityViewModel">
  <UserControl.Resources>
    <x:Double x:Key="QxFontSizeDisplay">16</x:Double>
    <x:Double x:Key="QxLineHeightDisplay">22</x:Double>
    <ControlTheme x:Key="Community.Row" TargetType="ListBoxItem" BasedOn="{StaticResource Library.RowItem}">
      <Setter Property="MinHeight" Value="76" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6,2" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource QxBorderSubtleBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding BackCommand}" />
  </UserControl.KeyBindings>
  <c:PageLayout Page="{Binding}">
    <c:PageLayout.Actions>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsInspecting}">
        <Button Content="Save copy" Command="{Binding SaveCopyCommand}" />
        <Button Classes="primary" Command="{Binding RunCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:Icon Kind="Play" Size="13" VerticalAlignment="Center" />
            <TextBlock Text="Run" />
          </StackPanel>
        </Button>
      </StackPanel>
    </c:PageLayout.Actions>
    <Grid>
      <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding !IsInspecting}">
        <Grid ColumnDefinitions="*,144,144,Auto" ColumnSpacing="10" Margin="24,12">
          <c:SearchBox Width="NaN" HorizontalAlignment="Stretch" PlaceholderText="Search scripts or authors" Text="{Binding SearchText, Mode=TwoWay}" MaxLength="80" AutomationProperties.Name="Search community scripts" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Script category" />
          <ComboBox Grid.Column="2" SelectedIndex="{Binding SortIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Sort scripts">
            <ComboBoxItem Content="Most liked" />
            <ComboBoxItem Content="Recently updated" />
          </ComboBox>
          <Button Grid.Column="3" Classes="icon" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh scripts" AutomationProperties.Name="Refresh scripts">
            <c:Icon Kind="Refresh" Size="15" />
          </Button>
        </Grid>
        <Grid Grid.Row="1">
          <ListBox Name="Scripts" ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript, Mode=TwoWay}"
                   ItemContainerTheme="{StaticResource Community.Row}"
                   Padding="18,0,18,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   DoubleTapped="open_script" AutomationProperties.Name="Community scripts">
            <ListBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedScript}" />
            </ListBox.KeyBindings>
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <c:UniformTilePanel ItemWidth="280" ItemHeight="80" StretchColumns="True" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:CommunityScript">
                <Border Padding="12,8" Background="Transparent" AutomationProperties.Name="{Binding Title}">
                  <ToolTip.Tip>
                    <StackPanel Spacing="4" MaxWidth="360">
                      <TextBlock Text="{Binding Title}" Classes="strong" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                    </StackPanel>
                  </ToolTip.Tip>
                  <Grid ColumnDefinitions="32,*" ColumnSpacing="16" VerticalAlignment="Center">
                    <c:Avatar DisplayName="{Binding HeadName}" Image="{Binding Head}" Width="32" Height="32" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" Classes="body" TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxLines="2" />
                      <TextBlock Text="{Binding AuthorText}" Classes="small tertiary" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}" Classes="small secondary" TextWrapping="Wrap" Margin="24,16" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="24,8,24,12">
          <TextBlock Text="{Binding PageText}" Classes="small tertiary" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="icon small" Command="{Binding PreviousCommand}" ToolTip.Tip="Previous page" AutomationProperties.Name="Previous page">
            <c:Icon Kind="ChevronLeft" Size="14" />
          </Button>
          <Button Grid.Column="2" Classes="icon small" Command="{Binding NextCommand}" ToolTip.Tip="Next page" AutomationProperties.Name="Next page">
            <c:Icon Kind="ChevronRight" Size="14" />
          </Button>
        </Grid>
      </Grid>
      <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsInspecting}" Margin="24,8,24,16">
        <StackPanel Spacing="6" Margin="0,0,0,16" IsVisible="{Binding HasDetail}">
          <TextBlock Text="{Binding Detail.Title}" Classes="title" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Detail.AuthorText, StringFormat='by {0}'}" Classes="small secondary" />
          <TextBlock Text="{Binding Detail.Description}" Classes="secondary" TextWrapping="Wrap" />
          <WrapPanel>
            <TextBlock Text="{Binding Detail.Category}" Classes="small tertiary" Margin="0,0,16,0" />
            <TextBlock Text="{Binding Detail.ScopeText}" Classes="small tertiary" Margin="0,0,16,0" />
            <TextBlock Text="{Binding Detail.UpdatedText}" Classes="small tertiary" />
          </WrapPanel>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="{DynamicResource QxBorderSubtleBrush}" BorderThickness="1" CornerRadius="{DynamicResource QxRadiusSm}" ClipToBounds="True" Background="{DynamicResource QxEditorBackgroundBrush}">
          <Grid RowDefinitions="Auto,*">
            <Border BorderBrush="{DynamicResource QxBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Source code" Classes="small secondary" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="subtle small" Command="{Binding CopyCodeCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:Icon Kind="Copy" Size="13" VerticalAlignment="Center" />
                    <TextBlock Text="Copy" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
            <ae:TextEditor Name="Source" Grid.Row="1" Classes="script" IsReadOnly="True" ShowLineNumbers="True"
                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                           IsVisible="{Binding HasDetail}" AutomationProperties.Name="Script source code" />
            <TextBlock Grid.Row="1" Text="{Binding Message}" Classes="small secondary" TextWrapping="Wrap" Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding !HasDetail}" />
          </Grid>
        </Border>
        <TextBlock Grid.Row="2" Text="{Binding Message}" IsVisible="{Binding HasDetail}" Classes="small secondary" TextWrapping="Wrap" Margin="0,10,0,0" />
      </Grid>
    </Grid>
  </c:PageLayout>
</UserControl>
