<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="using:Qx.Desktop.Behaviors"
             xmlns:c="using:Qx.Desktop.Controls"
             xmlns:vm="using:Qx.Presentation.ViewModels.Library"
             x:Class="Qx.Desktop.Views.Library.LibraryView"
             x:DataType="vm:LibraryViewModel">
  <UserControl.Styles>
    <Style Selector="Border.community-sheen">
      <Style.Animations>
        <Animation Duration="0:0:4.8" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="-80" /></KeyFrame>
          <KeyFrame Cue="42%"><Setter Property="TranslateTransform.X" Value="210" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="TranslateTransform.X" Value="210" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <c:PageLayout Page="{Binding}">
    <c:PageLayout.Actions>
      <Button Classes="primary" Content="New script" Command="{Binding NewScriptCommand}" />
    </c:PageLayout.Actions>
    <Grid ColumnDefinitions="184,*">
      <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource QxBorderSubtleBrush}">
        <Grid RowDefinitions="Auto,*,Auto" Margin="0,16,0,12">
          <TextBlock Text="Browse" Classes="small secondary strong" Margin="20,0,12,12" />
          <ListBox Name="Categories" Grid.Row="1"
                   ItemsSource="{Binding Filters}"
                   SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                   ItemContainerTheme="{StaticResource Library.FilterItem}"
                   AutomationProperties.Name="Script categories">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LibraryFilterOption">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="small tertiary" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Margin="12,12,8,0" Spacing="4">
            <Button Classes="subtle small" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Icon Kind="FolderOpen" Size="14" VerticalAlignment="Center" />
                <TextBlock Text="Scripts folder" />
              </StackPanel>
            </Button>
            <Grid>
              <Button Theme="{StaticResource Library.CommunityLink}" Classes="small" Command="{Binding CommunityCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:Icon Kind="OpenExternal" Size="14" VerticalAlignment="Center" />
                  <TextBlock Text="Community scripts" />
                </StackPanel>
              </Button>
              <Border ClipToBounds="True" CornerRadius="{DynamicResource QxRadiusSm}" IsHitTestVisible="False">
                <Grid ClipToBounds="True">
                  <Border Classes="community-sheen" Width="60" HorizontalAlignment="Left" Opacity="0.28">
                    <Border.RenderTransform>
                      <TranslateTransform X="-80" />
                    </Border.RenderTransform>
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0%,100%" EndPoint="100%,0%">
                        <GradientStop Offset="0.15" Color="Transparent" />
                        <GradientStop Offset="0.5" Color="{DynamicResource QxAccentColor}" />
                        <GradientStop Offset="0.85" Color="Transparent" />
                      </LinearGradientBrush>
                    </Border.Background>
                  </Border>
                </Grid>
              </Border>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="24,16,24,16">
          <c:SearchBox Name="Search"
                       Width="NaN" HorizontalAlignment="Stretch"
                       PlaceholderText="Search scripts"
                       Text="{Binding SearchText, Mode=TwoWay}"
                       b:FocusRequest.IsRequested="{Binding SearchFocusRequested, Mode=TwoWay}"
                       AutomationProperties.Name="Search scripts"
                       AutomationProperties.HelpText="Search by name or category within this view" />
          <ComboBox Grid.Column="1" Width="144" ItemsSource="{Binding Sorts}"
                    SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                    AutomationProperties.Name="Sort scripts">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LibrarySortOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="24,0,24,10">
          <TextBlock Text="{Binding FilterTitle}" Classes="strong" FontSize="15" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="small tertiary" VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>
        <Grid Grid.Row="2">
          <ListBox Name="Scripts" ItemsSource="{Binding Rows}"
                   IsVisible="{Binding HasResults}"
                   ItemContainerTheme="{StaticResource Library.RowItem}"
                   ItemsPanel="{StaticResource Library.ListPanel}"
                   Padding="0,0,0,12"
                   SelectionMode="Single" b:ListBehaviors.Selection="{Binding Selection}"
                   AutomationProperties.Name="Saved scripts"
                   AutomationProperties.HelpText="Press Enter or double-click to open, F2 to rename, Delete to remove">
            <ListBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding OpenCommand}" />
              <KeyBinding Gesture="F2" Command="{Binding RenameCommand}" />
              <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
            </ListBox.KeyBindings>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LibraryScriptRow">
                <Grid ColumnDefinitions="24,*,Auto,Auto" ColumnSpacing="12"
                      Background="Transparent" ToolTip.Tip="{Binding DetailTooltip}"
                      AutomationProperties.Name="{Binding AccessibilityText}">
                  <c:Icon Kind="Script" Size="19" Classes="tertiary" VerticalAlignment="Center" />
                  <Grid Grid.Column="1" RowDefinitions="Auto,Auto" RowSpacing="5">
                    <TextBlock Text="{Binding Name}" Classes="body strong" TextTrimming="CharacterEllipsis" />
                    <WrapPanel Grid.Row="1">
                      <TextBlock Text="{Binding CategoryName}" Classes="small secondary" Margin="0,0,16,0" />
                      <TextBlock Text="{Binding EditedText}" Classes="small tertiary" Margin="0,0,16,0" />
                      <TextBlock Text="{Binding RunText}" Classes="small"
                                 Classes.running="{Binding IsRunning}" Classes.accent="{Binding IsReady}"
                                 Classes.secondary="{Binding HasRun}" Classes.danger="{Binding IsFailed}"
                                 Classes.tertiary="{Binding IsNeverRun}" />
                    </WrapPanel>
                  </Grid>
                  <Button Grid.Column="2" Classes="subtle small" Content="Open" VerticalAlignment="Center"
                          Command="{Binding $parent[UserControl].((vm:LibraryViewModel)DataContext).OpenCommand}"
                          CommandParameter="{Binding}" AutomationProperties.Name="Open script" />
                  <Button Grid.Column="3" Classes="icon small" VerticalAlignment="Center"
                          Click="open_menu" ToolTip.Tip="More actions" AutomationProperties.Name="Script actions">
                    <c:Icon Kind="Dots" Size="16" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel IsVisible="{Binding !HasResults}" VerticalAlignment="Center" Margin="24" Spacing="16">
            <c:EmptyState Icon="Script" Title="{Binding EmptyHeading}" Description="{Binding EmptyDetail}" />
            <Button Content="Show all scripts" Classes="subtle" HorizontalAlignment="Center"
                    Command="{Binding ClearFiltersCommand}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </c:PageLayout>
</UserControl>
