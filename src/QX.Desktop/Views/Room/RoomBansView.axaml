<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="using:Qx.Desktop.Behaviors"
             xmlns:c="using:Qx.Desktop.Controls"
             xmlns:v="using:Qx.Desktop.Views.Room"
             xmlns:vm="using:Qx.Presentation.ViewModels.Room"
             x:Class="Qx.Desktop.Views.Room.RoomBansView"
             x:DataType="vm:RoomBansViewModel">
  <Grid RowDefinitions="Auto,*">
    <c:FilterBar BorderBrush="{DynamicResource QxBorderSubtleBrush}" BorderThickness="0,0,0,1">
      <c:FilterBar.Search>
        <c:SearchBox Width="280"
                     Text="{Binding Filter}"
                     PlaceholderText="Filter the ban list"
                     AutomationProperties.Name="Filter the ban list" />
      </c:FilterBar.Search>
      <c:FilterBar.Trailing>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Command="{Binding LoadCommand}" ToolTip.Tip="Ask the hotel for the ban list">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="Refresh" Size="14" VerticalAlignment="Center" />
              <TextBlock Text="Load" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="danger-outline" Command="{Binding UnbanCommand}" ToolTip.Tip="Let the selected people back in">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Kind="Unban" Size="14" VerticalAlignment="Center" />
              <TextBlock Text="Unban" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </c:FilterBar.Trailing>
    </c:FilterBar>

    <c:StateHost Grid.Row="1" State="{Binding State}">
      <DataGrid ItemsSource="{Binding Rows.Visible}"
                b:ListBehaviors.Selection="{Binding Selection}"
                b:ListBehaviors.SortRefresh="{Binding SortRefresh}"
                b:ListBehaviors.CopyCommand="{Binding CopySelectionCommand}"
                SelectionMode="Extended"
                HeadersVisibility="Column"
                RowHeight="{StaticResource QxRowHeightLarge}"
                IsReadOnly="True"
                CanUserSortColumns="True"
                CanUserResizeColumns="True"
                CanUserReorderColumns="True"
                ClipboardCopyMode="None"
                AutomationProperties.Name="People banned from this room">
        <DataGrid.ContextMenu>
          <ContextMenu Opening="OnMenuOpening">
            <MenuItem Header="Unban" Command="{Binding UnbanCommand}">
              <MenuItem.Icon>
                <c:Icon Kind="Unban" />
              </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Copy name" Command="{Binding CopyNamesCommand}">
              <MenuItem.Icon>
                <c:Icon Kind="Copy" />
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <c:DataGridGutterColumn x:DataType="vm:PersonRowViewModel" />
          <DataGridTemplateColumn x:DataType="vm:PersonRowViewModel" Header="Name" Width="2*" SortMemberPath="Name">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:PersonRowViewModel">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,0" VerticalAlignment="Center">
                  <c:Avatar DisplayName="{Binding Name}"
                            Image="{Binding Head}"
                            Kind="{Binding Kind, Converter={x:Static v:RoomLook.PersonKind}}" />
                  <TextBlock Text="{Binding Name}" Classes="strong" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn x:DataType="vm:PersonRowViewModel" Header="Id" Width="*" SortMemberPath="UserId">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:PersonRowViewModel">
                <TextBlock Text="{Binding IdText}" Classes="mono tertiary" Margin="12,0" VerticalAlignment="Center" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <c:DataGridGutterColumn x:DataType="vm:PersonRowViewModel" />
        </DataGrid.Columns>
      </DataGrid>
    </c:StateHost>
  </Grid>
</UserControl>
