<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Qx.Desktop.Controls"
             xmlns:local="using:Qx.Desktop.Views.ScriptPanels"
             xmlns:vm="using:Qx.Presentation.ViewModels.ScriptPanels"
             xmlns:nodes="using:Qx.Presentation.Services.Panels"
             x:Class="Qx.Desktop.Views.ScriptPanels.ScriptPanelView"
             x:DataType="vm:ScriptPanelViewModel">

  <UserControl.Resources>
    <local:PanelPercent x:Key="PanelPercent" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBox.qx-multiline">
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MinHeight" Value="{DynamicResource ScriptPanels.MultilineMinHeight}" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="c|Icon.qx-chevron">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="{StaticResource QxEaseStandard}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="ToggleButton:not(:checked) c|Icon.qx-chevron">
      <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>
    <Style Selector="Grid.qx-busy > TextBlock">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.qx-toast">
      <Setter Property="Width" Value="{DynamicResource ScriptPanels.ToastWidth}" />
      <Setter Property="Background" Value="{DynamicResource QxSurfaceOverlayBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource QxBorderOverlayBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource QxRadiusMd}" />
      <Setter Property="BoxShadow" Value="{DynamicResource QxShadowPopup}" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Opacity" Value="0" />
      <Style.Animations>
        <Animation Duration="0:0:0.24" Easing="{StaticResource QxEaseStandard}" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="8" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="TranslateTransform.Y" Value="0" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>

    <DataTemplate DataType="nodes:PanelTextFieldNode" x:DataType="nodes:PanelTextFieldNode">
      <StackPanel IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding Tooltip}">
        <TextBlock Classes="field-label" Text="{Binding Label}" />
        <TextBox Text="{Binding Text, Mode=TwoWay}"
                 Classes.qx-multiline="{Binding IsMultiline}"
                 PlaceholderText="{Binding Placeholder}"
                 AutomationProperties.Name="{Binding Label}"
                 AutomationProperties.HelpText="{Binding Help}" />
        <TextBlock Classes="helper" Text="{Binding Help}" TextWrapping="Wrap"
                   IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelNumberFieldNode" x:DataType="nodes:PanelNumberFieldNode">
      <StackPanel IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding Tooltip}">
        <TextBlock Classes="field-label" Text="{Binding Label}" />
        <TextBox Classes="mono" Text="{Binding Text, Mode=TwoWay}"
                 PlaceholderText="{Binding Placeholder}"
                 AutomationProperties.Name="{Binding Label}"
                 AutomationProperties.HelpText="{Binding Help}" />
        <TextBlock Classes="helper" Text="{Binding Help}" TextWrapping="Wrap"
                   IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelBoolFieldNode" x:DataType="nodes:PanelBoolFieldNode">
      <StackPanel IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding Tooltip}">
        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                  AutomationProperties.Name="{Binding Label}"
                  AutomationProperties.HelpText="{Binding Help}" />
        <TextBlock Classes="helper" Text="{Binding Help}" Margin="24,6,0,0" TextWrapping="Wrap"
                   IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelSelectFieldNode" x:DataType="nodes:PanelSelectFieldNode">
      <StackPanel IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding Tooltip}">
        <TextBlock Classes="field-label" Text="{Binding Label}" />
        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  PlaceholderText="{Binding Placeholder}"
                  AutomationProperties.Name="{Binding Label}"
                  AutomationProperties.HelpText="{Binding Help}" />
        <TextBlock Classes="helper" Text="{Binding Help}" TextWrapping="Wrap"
                   IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelSliderFieldNode" x:DataType="nodes:PanelSliderFieldNode">
      <StackPanel IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding Tooltip}">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBlock Classes="field-label" Text="{Binding Label}" Margin="0" VerticalAlignment="Center" />
          <Border Grid.Column="1" Classes="value-chip">
            <TextBlock Text="{Binding Readout}" />
          </Border>
        </Grid>
        <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value, Mode=TwoWay}"
                IsSnapToTickEnabled="{Binding IsWhole}" TickFrequency="1"
                AutomationProperties.Name="{Binding Label}" />
        <TextBlock Classes="helper" Text="{Binding Help}" TextWrapping="Wrap"
                   IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelColorFieldNode" x:DataType="nodes:PanelColorFieldNode">
      <StackPanel IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding Tooltip}">
        <TextBlock Classes="field-label" Text="{Binding Label}" />
        <DockPanel>
          <local:PanelColorSwatch DockPanel.Dock="Left" Value="{Binding Text}"
                                  Width="{DynamicResource ScriptPanels.SwatchSize}"
                                  Height="{DynamicResource ScriptPanels.SwatchSize}"
                                  CornerRadius="{DynamicResource QxRadiusSm}"
                                  BorderBrush="{DynamicResource QxBorderDefaultBrush}"
                                  BorderThickness="1"
                                  Margin="0,0,8,0" />
          <TextBox Classes="mono" Text="{Binding Text, Mode=TwoWay}" PlaceholderText="{Binding Placeholder}"
                   AutomationProperties.Name="{Binding Label}" />
        </DockPanel>
        <TextBlock Classes="helper" Text="{Binding Help}" TextWrapping="Wrap"
                   IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelFileFieldNode" x:DataType="nodes:PanelFileFieldNode">
      <StackPanel IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding Tooltip}">
        <TextBlock Classes="field-label" Text="{Binding Label}" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Browse" Margin="8,0,0,0"
                  Command="{Binding $parent[local:ScriptPanelView].((vm:ScriptPanelViewModel)DataContext).BrowseCommand}"
                  CommandParameter="{Binding}"
                  AutomationProperties.Name="{Binding Label}" />
          <TextBox Classes="mono" IsReadOnly="True" Text="{Binding Path}" PlaceholderText="{Binding Placeholder}"
                   AutomationProperties.Name="{Binding Label}" />
        </DockPanel>
        <TextBlock Classes="helper" Text="{Binding Help}" TextWrapping="Wrap"
                   IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelButtonNode" x:DataType="nodes:PanelButtonNode">
      <Button Classes="large"
              Classes.primary="{Binding IsPrimary}"
              Classes.subtle="{Binding IsQuiet}"
              Classes.danger="{Binding IsDanger}"
              MinWidth="96"
              Margin="0,0,8,0"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Stretch"
              Command="{Binding PressCommand}"
              IsVisible="{Binding IsVisible}"
              ToolTip.Tip="{Binding Tooltip}"
              AutomationProperties.Name="{Binding Label}">
        <Grid Classes.qx-busy="{Binding IsBusy}">
          <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <c:Spinner Size="14" IsVisible="{Binding IsBusy}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{Binding $parent[Button].Foreground}" />
        </Grid>
      </Button>
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelButtonStripNode" x:DataType="nodes:PanelButtonStripNode">
      <ItemsControl Classes="bounded" ItemsSource="{Binding Buttons}" IsVisible="{Binding IsVisible}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelOutputNode" x:DataType="nodes:PanelOutputNode">
      <StackPanel IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding Tooltip}">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <TextBlock Classes="field-label" Text="{Binding Label}" Margin="0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasToolbar}">
            <Button Classes="icon small" Command="{Binding ClearCommand}" ToolTip.Tip="Clear" AutomationProperties.Name="Clear output">
              <c:Icon Kind="ClearAll" Size="14" />
            </Button>
            <c:CopyButton Command="{Binding Copy.CopyCommand}" IsCopied="{Binding Copy.Copied}" AutomationProperties.Name="Copy output" />
          </StackPanel>
        </Grid>
        <Border Classes="panel" Height="{Binding Height}">
          <local:PanelOutputView />
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelTableNode" x:DataType="nodes:PanelTableNode">
      <StackPanel IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding Tooltip}">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
          <TextBlock Classes="field-label" Text="{Binding Label}" Margin="0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="mono caption tertiary" Text="{Binding RowCountText}" Margin="8,0,0,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasToolbar}">
            <Button Classes="icon small" Command="{Binding ClearCommand}" ToolTip.Tip="Clear" AutomationProperties.Name="Clear table">
              <c:Icon Kind="ClearAll" Size="14" />
            </Button>
            <c:CopyButton Command="{Binding Copy.CopyCommand}" IsCopied="{Binding Copy.Copied}" AutomationProperties.Name="Copy table" />
          </StackPanel>
        </Grid>
        <Border Classes="panel" Height="{Binding Height}">
          <local:PanelTableView />
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelProgressNode" x:DataType="nodes:PanelProgressNode">
      <StackPanel IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding Tooltip}">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <TextBlock Classes="field-label" Text="{Binding Label}" Margin="0" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="mono caption" FontWeight="Medium"
                     Text="{Binding Fraction, Converter={StaticResource PanelPercent}}" VerticalAlignment="Center" />
        </Grid>
        <ProgressBar Classes="running" Minimum="0" Maximum="1" Value="{Binding Fraction}"
                     AutomationProperties.Name="{Binding Label}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelStatusNode" x:DataType="nodes:PanelStatusNode">
      <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding Tooltip}">
        <TextBlock Classes="field-label" Text="{Binding Label}" Margin="0,0,10,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="body secondary" Text="{Binding Text}" FontWeight="Medium"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Text}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelLabelNode" x:DataType="nodes:PanelLabelNode">
      <SelectableTextBlock Classes="body secondary" Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding IsVisible}" />
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelSectionNode" x:DataType="nodes:PanelSectionNode">
      <Grid ColumnDefinitions="Auto,*" Margin="0,12,0,4" IsVisible="{Binding IsVisible}">
        <TextBlock Classes="heading primary" Text="{Binding Title}" VerticalAlignment="Center" />
        <Rectangle Grid.Column="1" Classes="rule" Margin="12,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelSeparatorNode" x:DataType="nodes:PanelSeparatorNode">
      <Rectangle Classes="rule" Margin="0,4" IsVisible="{Binding IsVisible}" />
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelSpacerNode" x:DataType="nodes:PanelSpacerNode">
      <Border Height="{Binding Height}" IsVisible="{Binding IsVisible}" />
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelRowNode" x:DataType="nodes:PanelRowNode">
      <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding IsVisible}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <local:PanelRowPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </DataTemplate>

    <DataTemplate DataType="nodes:PanelGroupNode" x:DataType="nodes:PanelGroupNode">
      <Border Classes="panel" Padding="4" IsVisible="{Binding IsVisible}" ToolTip.Tip="{Binding Tooltip}">
        <StackPanel>
          <ToggleButton Theme="{StaticResource ScriptPanels.GroupHeader}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                        AutomationProperties.Name="{Binding Title}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Classes="qx-chevron tertiary" Kind="ChevronDown" Size="14" VerticalAlignment="Center" />
              <TextBlock Classes="strong primary" Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ItemsControl ItemsSource="{Binding Children}" Margin="12,4,12,12" IsVisible="{Binding IsExpanded}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <local:PanelStack />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>

  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" IsVisible="{Binding HasErrors}" Padding="32,8" Classes="hairline-bottom"
            Background="{DynamicResource QxDangerBandBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <c:Icon Kind="Error" Size="16" VerticalAlignment="Center" Foreground="{DynamicResource QxDangerBrush}" />
        <TextBlock Grid.Column="1" Classes="body danger" Text="{Binding ErrorSummary}" TextTrimming="CharacterEllipsis"
                   Margin="8,0" VerticalAlignment="Center" />
        <Button Grid.Column="2" Theme="{StaticResource QxLinkButton}" Content="View in code" Command="{Binding ShowCodeCommand}" />
      </Grid>
    </Border>

    <Panel Grid.Row="1">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="32,24,32,32">
        <StackPanel HorizontalAlignment="Left" MaxWidth="{DynamicResource QxPanelMaxWidth}">
          <SelectableTextBlock Classes="body secondary" Text="{Binding Panel.Description}" TextWrapping="Wrap" Margin="0,0,0,24"
                               IsVisible="{Binding Panel.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <ItemsControl ItemsSource="{Binding Panel.Nodes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <local:PanelStack />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <ItemsControl Classes="bounded"
                    ItemsSource="{Binding Panel.Toasts.Toasts}"
                    IsHitTestVisible="False"
                    Focusable="False"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="16">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="nodes:PanelToast">
            <Border Classes="qx-toast" Classes.problem="{Binding IsProblem}">
              <Grid ColumnDefinitions="Auto,*">
                <c:Icon Kind="Warning" Size="16" Margin="0,1,10,0" VerticalAlignment="Top"
                        Foreground="{DynamicResource QxDangerBrush}" IsVisible="{Binding IsProblem}" />
                <c:Icon Kind="Info" Size="16" Margin="0,1,10,0" VerticalAlignment="Top"
                        Foreground="{DynamicResource QxAccentBrush}" IsVisible="{Binding !IsProblem}" />
                <TextBlock Grid.Column="1" Classes="body" Text="{Binding Text}" TextWrapping="Wrap"
                           Foreground="{DynamicResource QxTextPrimaryBrush}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Panel>

  </Grid>

</UserControl>
