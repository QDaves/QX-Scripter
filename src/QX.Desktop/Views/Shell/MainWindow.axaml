<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Qx.Desktop.Controls"
        xmlns:shell="using:Qx.Desktop.Views.Shell"
        xmlns:editor="using:Qx.Desktop.Views.Editor"
        xmlns:vm="using:Qx.Presentation.ViewModels.Shell"
        x:Class="Qx.Desktop.Views.Shell.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="QX Scripter"
        Width="{DynamicResource QxWindowDefaultWidth}"
        Height="{DynamicResource QxWindowDefaultHeight}"
        MinWidth="{DynamicResource QxWindowMinWidth}"
        MinHeight="{DynamicResource QxWindowMinHeight}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="{DynamicResource QxTitleBarHeight}"
        WindowDecorationsTheme="{DynamicResource QxWindowDecorations}">

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">
    <shell:TitleBar Name="Chrome" Grid.Row="0" Grid.ColumnSpan="2" />
    <shell:Rail Grid.Row="1" Grid.Column="0" />
    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*">
      <editor:DocumentTabStrip Name="Strip" DataContext="{x:Null}" IsVisible="False" />
      <c:PageHost Name="Pages" Grid.Row="1" Page="{Binding Navigation.CurrentPage}" />
    </Grid>
    <shell:StatusBar Grid.Row="2" Grid.ColumnSpan="2" />
    <c:ToastHost Grid.Row="1"
                 Grid.Column="1"
                 ZIndex="90"
                 Toasts="{Binding Notifications.Toasts}"
                 DismissCommand="{Binding DismissToastCommand}" />
    <c:DialogHost Name="Dialogs"
                  Grid.Row="0"
                  Grid.RowSpan="3"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  ZIndex="100"
                  Dialog="{Binding Dialogs.Current}" />
    <Panel Name="PaletteLayer"
           Grid.Row="0"
           Grid.RowSpan="3"
           Grid.Column="0"
           Grid.ColumnSpan="2"
           ZIndex="105"
           Background="Transparent"
           IsVisible="{Binding Palette.IsOpen}">
      <ContentControl Name="Palette"
                      Margin="{DynamicResource QxPaletteTopMargin}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Content="{Binding Palette}" />
    </Panel>
  </Grid>

</Window>
