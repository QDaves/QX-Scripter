<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Qx.Scripter</RootNamespace>
    <AssemblyName>QX.Scripter</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QX" Version="$(QxFrameworkVersion)" />
    <PackageReference Include="QX.Mcp" Version="$(QxFrameworkVersion)" />
    <PackageReference Include="QX.Scripting" Version="$(QxFrameworkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(QxDocumentationSource)/*.md;$(QxDocumentationSource)/toc.yml" LogicalName="Qx.Docs.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Knowledge/qx-wired.skill" LogicalName="Qx.WiredSkill" />
  </ItemGroup>

  <Target Name="VerifyScriptingDocumentation" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(QxDocumentationSource)/toc.yml')" Text="Scripting documentation is missing. Run tools/prepare-docs.ps1 first." />
  </Target>

</Project>
