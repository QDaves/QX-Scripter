<Application x:Class="Qx.Ui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Qx.Ui"
             xmlns:rpe="clr-namespace:RoslynPad.Editor;assembly=RoslynPad.Editor.Windows"
             xmlns:aeSearch="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit"
             xmlns:aeCC="clr-namespace:ICSharpCode.AvalonEdit.CodeCompletion;assembly=ICSharpCode.AvalonEdit"
             xmlns:presentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Indigo" SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <ResourceDictionary Source="Assets/QxMark.xaml" />
                <ResourceDictionary Source="PageChrome.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="FontUI">Segoe UI Variable, Segoe UI</FontFamily>
            <FontFamily x:Key="FontCode">Cascadia Code, Cascadia Mono, Consolas</FontFamily>

            <SolidColorBrush x:Key="QxAccentBrush" Color="#9B8CFF" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="QxAccentSoftBrush" Color="#329B8CFF" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="QxSelectionBrush" Color="#393449" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="QxSuccessBrush" Color="#59D77A" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="QxSuccessSoftBrush" Color="#2459D77A" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="QxDangerBrush" Color="#FF7665" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="QxDangerSoftBrush" Color="#24FF7665" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="QxWarningBrush" Color="#FFB454" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="QxSurfaceSubtleBrush" Color="#18CEC4E8" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="QxTextSecondaryBrush" Color="#D4D0DF" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="QxTextMutedBrush" Color="#9D97AA" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="ConnectedBrush" Color="#59D77A" presentationOptions:Freeze="False" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FF7665" presentationOptions:Freeze="False" />


            <!-- A heading over a group of settings or shortcuts. -->
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource QxTextMutedBrush}" />
                <Setter Property="Margin" Value="0,0,0,7" />
            </Style>

            <!-- Ordinary prose and values: everything a dialog is actually saying. -->
            <Style x:Key="BodyText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{DynamicResource QxTextSecondaryBrush}" />
            </Style>

            <!-- The line under a control explaining it, which is read once and then never again. -->
            <Style x:Key="HintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource QxTextMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate />
                    </Setter.Value>
                </Setter>
            </Style>

            <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
            <CornerRadius x:Key="RadiusMedium">6</CornerRadius>
            <CornerRadius x:Key="RadiusLarge">10</CornerRadius>

            <!-- IntelliSense completion / insight popups (theme-aware, not white) -->
            <Style TargetType="{x:Type aeCC:CompletionWindow}">
                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style TargetType="{x:Type aeCC:CompletionListBox}">
                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource QxAccentSoftBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type aeCC:InsightWindow}">
                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
            </Style>

            <local:BoolToVisibilityConverter x:Key="BoolToVis" />
            <local:GlyphToImageConverter x:Key="GlyphToImage" />
            <local:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
            <local:OnlineBrushConverter x:Key="OnlineBrush" />
            <local:NotConverter x:Key="Not" />
            <local:NullToVisibilityConverter x:Key="NullToVis" />

            <ControlTemplate x:Key="QxButtonTemplate" TargetType="{x:Type Button}">
                <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{Binding Path=(materialDesign:ButtonAssist.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True" />
                </Border>
            </ControlTemplate>

            <ControlTemplate x:Key="QxToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
                <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{Binding Path=(materialDesign:ButtonAssist.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True" />
                </Border>
            </ControlTemplate>

            <Style x:Key="CaptionButton" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Template" Value="{StaticResource QxButtonTemplate}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource QxSurfaceSubtleBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource QxAccentSoftBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.35" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource QxDangerSoftBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource QxDangerBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource QxDangerBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Background}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="46" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource QxTextSecondaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="12" />
                <Setter Property="Template" Value="{StaticResource QxButtonTemplate}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource QxSurfaceSubtleBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource QxAccentSoftBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource QxAccentBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Cursor" Value="Arrow" />
                        <Setter Property="Opacity" Value="0.35" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="NavToggleButton" TargetType="ToggleButton">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="46" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource QxTextSecondaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="12" />
                <Setter Property="Template" Value="{StaticResource QxToggleButtonTemplate}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource QxSurfaceSubtleBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{DynamicResource QxAccentSoftBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource QxAccentBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource QxAccentSoftBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource QxAccentBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Cursor" Value="Arrow" />
                        <Setter Property="Opacity" Value="0.35" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SidebarButton" TargetType="Button">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource QxTextMutedBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="9" />
                <Setter Property="Template" Value="{StaticResource QxButtonTemplate}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource QxSurfaceSubtleBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Cursor" Value="Arrow" />
                        <Setter Property="Opacity" Value="0.35" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A page in the rail. The bar on the left says which page is open: with icon-only
                 buttons a filled background alone reads as hover, and there is nowhere to put a
                 label that would say it outright. -->
            <ControlTemplate x:Key="QxNavToggleTemplate" TargetType="{x:Type ToggleButton}">
                <Grid SnapsToDevicePixels="True">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <Border x:Name="Marker" Width="2" Height="18" HorizontalAlignment="Left"
                            VerticalAlignment="Center" Background="{DynamicResource QxAccentBrush}"
                            Visibility="Collapsed" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Root" Property="Background"
                                Value="{DynamicResource QxAccentSoftBrush}" />
                        <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                        <Setter Property="Foreground"
                                Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Root" Property="Background"
                                Value="{DynamicResource QxSurfaceSubtleBrush}" />
                        <Setter Property="Foreground"
                                Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.35" />
                        <Setter Property="Cursor" Value="Arrow" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="SidebarNavToggle" TargetType="ToggleButton">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="35" />
                <Setter Property="Margin" Value="0,0,0,1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource QxTextMutedBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
                <Setter Property="Template" Value="{StaticResource QxNavToggleTemplate}" />
            </Style>

            <!-- The same shape as the nav toggle, for the things on the rail that are acts rather
                 than places: making a new script does not leave you anywhere. -->
            <Style x:Key="SidebarNavButton" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="35" />
                <Setter Property="Margin" Value="0,0,0,1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource QxTextMutedBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
                <Setter Property="Template" Value="{StaticResource QxButtonTemplate}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource QxSurfaceSubtleBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource QxAccentSoftBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.35" />
                        <Setter Property="Cursor" Value="Arrow" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SidebarToggleButton" TargetType="ToggleButton">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource QxTextMutedBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="9" />
                <Setter Property="Template" Value="{StaticResource QxToggleButtonTemplate}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource QxSurfaceSubtleBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Cursor" Value="Arrow" />
                        <Setter Property="Opacity" Value="0.35" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="TabCloseButton" TargetType="Button">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource QxTextMutedBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource QxSurfaceSubtleBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Card.Background}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Cursor" Value="Arrow" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ToolbarIconButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="30" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="7" />
            </Style>

            <Style x:Key="ToolIconButton" TargetType="Button" BasedOn="{StaticResource ToolbarIconButton}" />

            <!-- Sized so the pair plus its plate comes to the same 30 as the run button beside it,
                 instead of standing four pixels taller than everything else on the row. -->
            <Style x:Key="ViewModeToggle" TargetType="ToggleButton" BasedOn="{StaticResource NavToggleButton}">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="42" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="3" />
            </Style>

            <ControlTemplate x:Key="RunActionButtonTemplate" TargetType="{x:Type Button}">
                <Grid SnapsToDevicePixels="True">
                    <Border CornerRadius="3"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}" />
                    <Border Margin="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Background="{TemplateBinding Background}">
                        <!-- Even margins. The old right margin of 18 left "Compiling" less room
                             than it needs and clipped it. -->
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          Margin="8,0,8,0"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <!-- Both only ever show over the red running button, so they are white outright
                         rather than a theme brush that has to work on two backgrounds.

                         The dash array and the offset are in units of stroke thickness, and one
                         cycle has to come to exactly one lap or the pattern lands on a different
                         phase each time round and steps at the corner the path starts from. The lap
                         is 2*(102.6-4.8) + 2*(28.6-4.8) + 2*pi*2.4 = 258.28px, which over a 1.9
                         stroke is 135.94 units, so that is the cycle and that is the travel. Redo
                         this if the button's size, its radius or the stroke ever change. -->
                    <Rectangle Margin="0.7"
                               RadiusX="2.4"
                               RadiusY="2.4"
                               Stroke="White"
                               StrokeThickness="1.5"
                               Opacity="0.5"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <Rectangle Margin="0.7"
                               RadiusX="2.4"
                               RadiusY="2.4"
                               Stroke="White"
                               StrokeThickness="1.9"
                               StrokeDashArray="32 103.94"
                               StrokeDashCap="Round"
                               IsHitTestVisible="False">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Opacity" Value="0.92" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="run_outline_storyboard">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset"
                                                                     From="0"
                                                                     To="-135.94"
                                                                     Duration="0:0:3.2"
                                                                     RepeatBehavior="Forever"
                                                                     Timeline.DesiredFrameRate="30" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <RemoveStoryboard BeginStoryboardName="run_outline_storyboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <TextBlock Text="F5"
                               Margin="0,4,7,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               FontFamily="{StaticResource FontCode}"
                               FontSize="8"
                               Foreground="{TemplateBinding Foreground}"
                               Opacity="0.52"
                               IsHitTestVisible="False" />
                </Grid>
            </ControlTemplate>

            <Style x:Key="RunActionButton" TargetType="Button">
                <Setter Property="Width" Value="104" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Background" Value="{DynamicResource QxSurfaceSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource QxTextSecondaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template" Value="{StaticResource RunActionButtonTemplate}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource QxAccentSoftBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Opacity" Value="0.78" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Cursor" Value="Arrow" />
                        <Setter Property="Opacity" Value="0.42" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="OutputActionButton" TargetType="Button" BasedOn="{StaticResource ToolbarIconButton}">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{DynamicResource QxTextMutedBrush}" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6" />
            </Style>

            <Style x:Key="StatusIcon" TargetType="materialDesign:PackIcon">
                <Setter Property="Width" Value="17" />
                <Setter Property="Height" Value="17" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource QxTextMutedBrush}" />
            </Style>

            <Style x:Key="StatusText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="4,0,10,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource QxTextSecondaryBrush}" />
            </Style>

            <Style x:Key="SearchFlatButton" TargetType="Button" BasedOn="{StaticResource ToolbarIconButton}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="5" />
            </Style>

            <Style x:Key="SearchToggle" TargetType="ToggleButton" BasedOn="{StaticResource ViewModeToggle}">
                <Setter Property="Width" Value="28" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Margin" Value="1,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="5" />
            </Style>

            <Style x:Key="SearchTextBox" TargetType="TextBox">
                <Setter Property="Height" Value="28" />
                <Setter Property="Width" Value="170" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="FontFamily" Value="{StaticResource FontCode}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                <Setter Property="CaretBrush" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
                <Setter Property="SelectionBrush" Value="{DynamicResource QxAccentSoftBrush}" />
                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Background}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Divider}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    BorderBrush="{TemplateBinding BorderBrush}">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource QxAccentBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource QxSurfaceSubtleBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource QxTextMutedBrush}" />
                        <Setter Property="Opacity" Value="0.65" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="{x:Type rpe:SearchReplacePanel}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type rpe:SearchReplacePanel}">
                            <Border Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                    BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                                    CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,6,14,0" Padding="6,5" Cursor="Arrow"
                                    materialDesign:ElevationAssist.Elevation="Dp4"
                                    TextElement.FontFamily="{StaticResource FontUI}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource SearchToggle}" ToolTip="Toggle replace"
                                                      AutomationProperties.Name="Toggle replace"
                                                      IsChecked="{Binding IsReplaceMode, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                            <materialDesign:PackIcon Kind="FindReplace" Width="16" Height="16" />
                                        </ToggleButton>
                                        <TextBox x:Name="PART_searchTextBox" Style="{StaticResource SearchTextBox}" Margin="2,0,4,0"
                                                 AutomationProperties.Name="Search text"
                                                 Text="{Binding SearchPattern, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        <ToggleButton Style="{StaticResource SearchToggle}" ToolTip="Match case"
                                                      AutomationProperties.Name="Match case"
                                                      IsChecked="{Binding MatchCase, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                            <materialDesign:PackIcon Kind="FormatLetterCase" Width="17" Height="17" />
                                        </ToggleButton>
                                        <ToggleButton Style="{StaticResource SearchToggle}" ToolTip="Whole words"
                                                      AutomationProperties.Name="Whole words"
                                                      IsChecked="{Binding WholeWords, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                            <materialDesign:PackIcon Kind="FormatLetterMatches" Width="16" Height="16" />
                                        </ToggleButton>
                                        <ToggleButton Style="{StaticResource SearchToggle}" ToolTip="Use regex"
                                                      AutomationProperties.Name="Use regular expression"
                                                      IsChecked="{Binding UseRegex, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                            <materialDesign:PackIcon Kind="Regex" Width="16" Height="16" />
                                        </ToggleButton>
                                        <Border Width="1" Margin="4,3" Background="{DynamicResource MaterialDesign.Brush.Divider}" />
                                        <Button Style="{StaticResource SearchFlatButton}" ToolTip="Previous (Shift+Enter)"
                                                AutomationProperties.Name="Previous match"
                                                Command="{x:Static aeSearch:SearchCommands.FindPrevious}">
                                            <materialDesign:PackIcon Kind="ChevronUp" Width="18" Height="18" />
                                        </Button>
                                        <Button Style="{StaticResource SearchFlatButton}" ToolTip="Next (Enter)"
                                                AutomationProperties.Name="Next match"
                                                Command="{x:Static aeSearch:SearchCommands.FindNext}">
                                            <materialDesign:PackIcon Kind="ChevronDown" Width="18" Height="18" />
                                        </Button>
                                        <Button Style="{StaticResource SearchFlatButton}" ToolTip="Close (Esc)"
                                                AutomationProperties.Name="Close search"
                                                Command="{x:Static aeSearch:SearchCommands.CloseSearchPanel}">
                                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>

                                    <StackPanel x:Name="ReplaceButtons" Orientation="Horizontal" Margin="0,5,0,0"
                                        Visibility="{Binding IsReplaceMode, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}">
                                        <Border Width="28" />
                                        <TextBox x:Name="ReplaceBox" Style="{StaticResource SearchTextBox}" Margin="2,0,4,0"
                                                 AutomationProperties.Name="Replacement text"
                                                 Text="{Binding ReplacePattern, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Style="{StaticResource SearchFlatButton}" ToolTip="Replace next (Alt+R)"
                                                AutomationProperties.Name="Replace next"
                                                Command="{x:Static rpe:SearchCommandsEx.ReplaceNext}">
                                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="17" Height="17" />
                                        </Button>
                                        <Button Style="{StaticResource SearchFlatButton}" ToolTip="Replace all (Alt+A)"
                                                AutomationProperties.Name="Replace all"
                                                Command="{x:Static rpe:SearchCommandsEx.ReplaceAll}">
                                            <materialDesign:PackIcon Kind="FileReplaceOutline" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
