<local:GamePage x:Class="Qx.Ui.ChatPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                xmlns:local="clr-namespace:Qx.Ui"
                Background="{DynamicResource MaterialDesign.Brush.Background}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,12">
            <TextBlock Text="Chat" Style="{StaticResource PageHeading}" />
            <TextBlock x:Name="Subheading" Style="{StaticResource PageSubheading}" />
        </StackPanel>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" CornerRadius="0"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="12,12,12,8">
                    <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="10,0" Height="30"
                            Style="{StaticResource OutputActionButton}"
                            Click="ClearLog" ToolTip="Clear the log"
                            AutomationProperties.Name="Clear the chat log">
                        <materialDesign:PackIcon Kind="DeleteSweepOutline" Width="15" Height="15" />
                    </Button>
                    <Border Style="{StaticResource PageFilterBox}">
                        <DockPanel>
                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,7,0"
                                                     Foreground="{DynamicResource QxTextMutedBrush}" />
                            <TextBox x:Name="Filter" Style="{StaticResource PageFilterText}"
                                     TextChanged="FilterChanged"
                                     Tag="Search the chat log" AutomationProperties.Name="Search the chat log" />
                        </DockPanel>
                    </Border>
                </DockPanel>

                <ListBox x:Name="Rows" Grid.Row="1" BorderThickness="0" Background="Transparent"
                         Margin="8,0,8,0" Padding="0"
                         ItemContainerStyle="{StaticResource GameRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Chat">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <!-- A head belongs to somebody speaking. A line about the room
                                     itself, or about somebody arriving, has nobody to picture, and a
                                     placeholder there reads as a person who failed to load. -->
                                <Grid DockPanel.Dock="Left" Width="54" Height="62"
                                      Margin="0,-9,4,-9" VerticalAlignment="Top"
                                      Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                                    <Image Source="{Binding Image}" Stretch="None"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Grid>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Trailing}" FontSize="10"
                                           VerticalAlignment="Top" Margin="10,2,0,0"
                                           Foreground="{DynamicResource QxTextMutedBrush}" />
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Margin="7,0,0,0" Padding="5,1" VerticalAlignment="Center"
                                                CornerRadius="{StaticResource RadiusSmall}"
                                                Background="{DynamicResource QxSurfaceSubtleBrush}"
                                                Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Tag}" FontSize="9.5"
                                                       Foreground="{DynamicResource QxTextMutedBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" FontSize="12.5" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"
                                               Foreground="{DynamicResource QxTextSecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="Status" Grid.Row="2" Margin="14,8,14,10" FontSize="11"
                           Foreground="{DynamicResource QxTextMutedBrush}" />
            </Grid>
        </Border>

        <Border x:Name="EmptyNotice" Grid.Row="1" CornerRadius="{StaticResource RadiusLarge}"
                Background="{DynamicResource MaterialDesign.Brush.Background}"
                Visibility="Collapsed">
            <StackPanel Style="{StaticResource PageEmptyNotice}">
                <materialDesign:PackIcon Kind="ChatOutline" Width="30" Height="30" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyText" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</local:GamePage>
