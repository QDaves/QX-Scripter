<Window x:Class="Qx.Ui.CommandPalette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Commands" Width="560" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontFamily="{StaticResource FontUI}" TextElement.FontSize="13"
        ShowInTaskbar="False" UseLayoutRounding="True"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- No title and no icon: the box is the whole interface, and anything above it is
                 one more thing to read before typing. -->
            <TextBox x:Name="Query" Grid.Row="0" BorderThickness="0"
                     Background="Transparent" FontSize="15"
                     Padding="16,13" TextChanged="OnQueryChanged"
                     AutomationProperties.Name="Search commands" />

            <Border Grid.Row="1" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
                <Grid>
                    <ListBox x:Name="Results" MaxHeight="380" BorderThickness="0"
                             Background="Transparent" Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseUp="OnResultClicked"
                             AutomationProperties.Name="Matching commands">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="row" Background="Transparent"
                                                    CornerRadius="6" Padding="10,7">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Gesture}"
                                                               FontFamily="{StaticResource FontCode}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource QxTextMutedBrush}"
                                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Group}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource QxTextMutedBrush}"
                                                               VerticalAlignment="Center"
                                                               MinWidth="62" Margin="0,0,10,0" />
                                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="row" Property="Background"
                                                            Value="{DynamicResource QxSurfaceSubtleBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="row" Property="Background"
                                                            Value="{DynamicResource QxSurfaceSubtleBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock x:Name="NoResults" Text="No matching command"
                               HorizontalAlignment="Center" Margin="0,26"
                               FontSize="12.5" Foreground="{DynamicResource QxTextMutedBrush}"
                               Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
