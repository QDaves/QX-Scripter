<Window x:Class="Qx.Ui.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Confirm" SizeToContent="Height" Width="420"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontFamily="{StaticResource FontUI}" TextElement.FontSize="13"
        ShowInTaskbar="False" UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="20,11,10,11">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" Width="20" Height="20"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource QxAccentBrush}" />
                        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="32" Height="32" Padding="0"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Click="OnCancel" ToolTip="Close"
                            AutomationProperties.Name="Close confirmation">
                        <materialDesign:PackIcon Kind="Close" Width="17" Height="17" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,22,24,20">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                           LineHeight="20" Foreground="{DynamicResource QxTextSecondaryBrush}"
                           AutomationProperties.LiveSetting="Polite" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource MaterialDesignFlatButton}"
                            Click="OnCancel" IsCancel="True" Margin="0,0,8,0"
                            AutomationProperties.Name="Cancel" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="OnConfirm" IsDefault="True"
                            AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
