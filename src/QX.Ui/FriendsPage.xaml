<local:GamePage x:Class="Qx.Ui.FriendsPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                xmlns:local="clr-namespace:Qx.Ui"
                Background="{DynamicResource MaterialDesign.Brush.Background}">
    <UserControl.Resources>
        <DataTemplate x:Key="FriendHeadCell">
            <Grid Width="60" Height="74" HorizontalAlignment="Center" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="AccountCircle" Width="18" Height="18"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="{DynamicResource QxTextMutedBrush}"
                                         Visibility="{Binding HasImage, Converter={StaticResource InvBoolToVis}}" />
                <Image Source="{Binding Image}" Stretch="None"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <Rectangle Fill="{DynamicResource QxTextMutedBrush}" IsHitTestVisible="False"
                           Opacity="{Binding Greyed}">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{Binding Image}" Stretch="None"
                                    AlignmentX="Center" AlignmentY="Center" />
                    </Rectangle.OpacityMask>
                </Rectangle>
            </Grid>
        </DataTemplate>

        <!-- A dot rather than a word: it is read at a glance and costs no column width. -->
        <DataTemplate x:Key="FriendStateCell">
            <Ellipse Width="8" Height="8" HorizontalAlignment="Center"
                     ToolTip="{Binding Trailing}"
                     Fill="{Binding IsOnline, Converter={StaticResource OnlineBrush}}" />
        </DataTemplate>

        <DataTemplate x:Key="FriendNameCell">
            <DockPanel>
                <Border DockPanel.Dock="Right" Margin="6,0,0,0" Padding="5,1" VerticalAlignment="Center"
                        CornerRadius="{StaticResource RadiusSmall}"
                        Background="{DynamicResource QxSurfaceSubtleBrush}"
                        Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Tag}" FontSize="9.5"
                               Foreground="{DynamicResource QxTextMutedBrush}" />
                </Border>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,12">
            <TextBlock Text="Friends" Style="{StaticResource PageHeading}" />
            <TextBlock x:Name="Subheading" Style="{StaticResource PageSubheading}" />
        </StackPanel>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" CornerRadius="0"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="{StaticResource PageToolbarMargin}">
                    <ToggleButton x:Name="OnlineOnly" DockPanel.Dock="Right" Margin="8,0,0,0"
                                  Style="{StaticResource ViewModeToggle}" MinWidth="72"
                                  Click="FilterToggled"
                                  ToolTip="Show only friends who are online"
                                  AutomationProperties.Name="Online only">
                        <TextBlock Text="Online" FontSize="11.5" />
                    </ToggleButton>
                    <Button DockPanel.Dock="Right" Margin="10,0,0,0"
                            Style="{StaticResource PageActionButton}" Click="Reload"
                            ToolTip="Ask the hotel for the friend list again">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="Reload" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource PageFilterBox}">
                        <DockPanel>
                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,7,0"
                                                     Foreground="{DynamicResource QxTextMutedBrush}" />
                            <TextBox x:Name="Filter" Style="{StaticResource PageFilterText}"
                                     TextChanged="FilterChanged"
                                     Tag="Search your friends" AutomationProperties.Name="Search your friends" />
                        </DockPanel>
                    </Border>
                </DockPanel>

                <DataGrid x:Name="Rows" Grid.Row="1" Style="{StaticResource QxDataGrid}"
                          Margin="4,0,4,0" RowHeight="76"
                          AutomationProperties.Name="Friends">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Whisper" Click="WhisperFriend"
                                      ToolTip="Only works while they are in the room with you">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="MessageOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Follow" Click="FollowFriend">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="AccountArrowRightOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Find in the room" Click="FindFriend">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="MapMarkerOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Open profile" Click="OpenFriendProfile">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="AccountOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Add outfit to my wardrobe" Click="FriendToWardrobe">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="TshirtCrewOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Copy">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentCopy" />
                                </MenuItem.Icon>
                                <MenuItem Header="Name"   Tag="name"   Click="CopyFriendField" />
                                <MenuItem Header="Id"     Tag="id"     Click="CopyFriendField" />
                                <MenuItem Header="Motto"  Tag="motto"  Click="CopyFriendField" />
                                <MenuItem Header="Figure" Tag="figure" Click="CopyFriendField" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Remove friend" Click="RemoveFriend">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="AccountMinusOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="30" SortMemberPath="IsOnline"
                                                CellTemplate="{StaticResource FriendStateCell}" />
                        <DataGridTemplateColumn Header="" Width="66" CanUserSort="False"
                                                CellTemplate="{StaticResource FriendHeadCell}" />
                        <DataGridTemplateColumn Header="NAME" Width="2*" SortMemberPath="Name"
                                                CellTemplate="{StaticResource FriendNameCell}" />
                        <DataGridTextColumn Header="MOTTO" Width="3*" Binding="{Binding Detail}"
                                            ElementStyle="{StaticResource QxDataGridTextElement}" />
                        <DataGridTextColumn Header="LAST SEEN" Width="130" Binding="{Binding Trailing}"
                                            ElementStyle="{StaticResource QxDataGridTextElement}" />
                        <DataGridTextColumn Header="ID" Width="*" Binding="{Binding Key}"
                                            ElementStyle="{StaticResource QxDataGridTextElement}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="Status" Grid.Row="2" Margin="14,8,14,10" FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource QxTextMutedBrush}" />

                <Border x:Name="EmptyNotice" Grid.Row="1" IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <StackPanel Style="{StaticResource PageEmptyNotice}">
                        <materialDesign:PackIcon Kind="AccountMultipleOutline" Width="30" Height="30"
                                                 HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyText" FontSize="14" Margin="0,10,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="320" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</local:GamePage>
