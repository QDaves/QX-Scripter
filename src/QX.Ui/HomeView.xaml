<UserControl x:Class="Qx.Ui.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesign.Brush.Background}">
    <UserControl.Resources>
        <ContextMenu x:Key="ScriptMenu">
            <MenuItem Header="Open" Click="OnMenuOpen">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileEditOutline" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Rename…" InputGestureText="F2" Click="OnMenuRename">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="RenameBox" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Category…" Click="OnMenuCategory">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="LabelOutline" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Duplicate" Click="OnMenuDuplicate">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentDuplicate" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Show in folder" Click="OnMenuReveal">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FolderOpenOutline" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Delete" InputGestureText="Del" Click="OnMenuDelete">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="DeleteOutline" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="ScriptDeleteButton" TargetType="Button" BasedOn="{StaticResource TabCloseButton}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="ToolTip" Value="Delete script" />
            <Setter Property="Visibility" Value="{Binding CanDelete, Converter={StaticResource BoolToVis}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                             Value="True">
                    <Setter Property="Opacity" Value="0.55" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Foreground" Value="{DynamicResource QxDangerBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScriptRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ContextMenu" Value="{StaticResource ScriptMenu}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding AccessibilityText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="2">
                            <Grid MinHeight="36" Margin="10,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="ScriptTextOutline" Width="15" Height="15"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource QxTextMutedBrush}" />
                                <TextBlock Grid.Column="1" Margin="0,7,16,7"
                                           Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"
                                           FontWeight="Medium" ToolTip="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="detail" Grid.Column="2" Text="{Binding Detail}"
                                           Foreground="{DynamicResource QxTextMutedBrush}"
                                           ToolTip="{Binding DetailTooltip}" TextTrimming="CharacterEllipsis"
                                           FontSize="11.5" VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="3" Width="11" Height="11" IsIndeterminate="True" Value="0"
                                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                                             Foreground="{StaticResource ConnectedBrush}"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                <Button Grid.Column="4" Style="{StaticResource ScriptDeleteButton}"
                                        HorizontalAlignment="Center" Click="OnDeleteClick"
                                        AutomationProperties.Name="{Binding DeleteAccessibilityText}">
                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" />
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding LastRunFailed}" Value="True">
                                <Setter TargetName="detail" Property="Foreground" Value="{DynamicResource QxDangerBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource QxSurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource QxAccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource QxTextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScriptTileStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="ContextMenu" Value="{StaticResource ScriptMenu}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding AccessibilityText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="tile" Width="184" Height="64" Margin="3"
                                CornerRadius="2"
                                Background="Transparent" BorderThickness="1"
                                ToolTip="{Binding Name}"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
                            <Grid Margin="10,8,6,5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium"
                                           Margin="0,0,4,0" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="tileDetail" Text="{Binding Detail}" FontSize="10.5"
                                               Foreground="{DynamicResource QxTextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DetailTooltip}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Width="10" Height="10"
                                                 IsIndeterminate="True" Value="0"
                                                 Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 Foreground="{StaticResource ConnectedBrush}"
                                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                    <Button Grid.Column="2" Style="{StaticResource ScriptDeleteButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="OnDeleteClick" AutomationProperties.Name="{Binding DeleteAccessibilityText}">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding LastRunFailed}" Value="True">
                                <Setter TargetName="tileDetail" Property="Foreground" Value="{DynamicResource QxDangerBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tile" Property="Background" Value="{DynamicResource QxSurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tile" Property="Background" Value="{DynamicResource QxAccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="tile" Property="BorderBrush" Value="{DynamicResource QxTextMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Keyed, so the implicit Material Design ToggleButton style does not reach it. That style
             is built for a switch: it fixes a size and centres its content, which left the group
             header showing a stray chevron in the middle of the row with the name and the count
             squeezed out of the box entirely. -->
        <Style x:Key="GroupHeaderToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="2"
                                Padding="10,7" Margin="3,10,3,3"
                                HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="chev" Kind="ChevronDown"
                                                         Width="15" Height="15"
                                                         Foreground="{DynamicResource QxTextMutedBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5"
                                           FontWeight="SemiBold" Foreground="{DynamicResource QxTextSecondaryBrush}"
                                           ToolTip="{Binding Name}" Margin="0,0,12,0"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock x:Name="count" Grid.Column="2" Text="{Binding ItemCount}" FontSize="11"
                                           Foreground="{DynamicResource QxTextMutedBrush}"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Border.ContextMenu>
                                <ContextMenu Opened="OnCategoryMenuOpened" />
                            </Border.ContextMenu>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="chev" Property="Kind" Value="ChevronRight" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource QxSurfaceSubtleBrush}" />
                                <Setter TargetName="chev" Property="Foreground"
                                        Value="{DynamicResource QxTextSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="ScriptRowPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="ScriptTilePanel">
            <WrapPanel Orientation="Horizontal" Margin="2,0" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid MaxWidth="{StaticResource PageContentWidth}" Margin="{StaticResource PageOuterMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="{StaticResource PageHeaderMargin}">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="12">
                <Hyperlink NavigateUri="http://qxscripter.xyz/" RequestNavigate="OpenCommunityScripts"
                           Foreground="{DynamicResource QxTextSecondaryBrush}" TextDecorations="{x:Null}"
                           ToolTip="Find and share scripts on qxscripter.xyz"
                           AutomationProperties.Name="Community scripts"
                           AutomationProperties.HelpText="Opens qxscripter.xyz in your browser">
                    <Run Text="Community scripts" />
                    <InlineUIContainer BaselineAlignment="Center">
                        <materialDesign:PackIcon Kind="OpenInNew" Width="13" Height="13" Margin="5,0,0,0" />
                    </InlineUIContainer>
                </Hyperlink>
            </TextBlock>
            <StackPanel>
                <TextBlock Text="Script library" Style="{StaticResource PageHeading}" />
                <TextBlock Text="Open, organise and manage your saved scripts."
                           Style="{StaticResource PageSubheading}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" CornerRadius="0"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="{StaticResource PageToolbarMargin}">
                    <Button DockPanel.Dock="Right" Click="OnNew" Margin="10,0,0,0"
                            Style="{StaticResource PageActionButton}"
                            ToolTip="Create a new script (Ctrl+N)"
                            AutomationProperties.Name="New script"
                            AutomationProperties.HelpText="Creates a new script tab"
                            AutomationProperties.AcceleratorKey="Ctrl+N">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilePlusOutline" Width="15" Height="15"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="New script" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border DockPanel.Dock="Right" Margin="10,0,0,0" Padding="2"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Background="{DynamicResource QxSurfaceSubtleBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="ListToggle" Style="{StaticResource ViewModeToggle}"
                                          MinWidth="40" Click="OnSelectListView"
                                          ToolTip="List view" AutomationProperties.Name="List view">
                                <materialDesign:PackIcon Kind="ViewListOutline" Width="15" Height="15" />
                            </ToggleButton>
                            <ToggleButton x:Name="GridToggle" Style="{StaticResource ViewModeToggle}"
                                          MinWidth="40" Click="OnSelectGridView"
                                          ToolTip="Grid view" AutomationProperties.Name="Grid view">
                                <materialDesign:PackIcon Kind="ViewGridOutline" Width="15" Height="15" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <Button x:Name="SortButton" DockPanel.Dock="Right" Margin="10,0,0,0"
                            Style="{StaticResource PageActionButton}" Click="OnSortClick"
                            AutomationProperties.Name="Sort scripts">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SortVariant" Width="15" Height="15"
                                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="SortLabelText" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                            <materialDesign:PackIcon Kind="ChevronDown" Width="13" Height="13"
                                                     Margin="5,0,0,0" VerticalAlignment="Center"
                                                     Opacity="0.65" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="SortMenu" Opened="OnSortMenuOpened" />
                        </Button.ContextMenu>
                    </Button>

                    <TextBlock x:Name="ResultCount" DockPanel.Dock="Right" MinWidth="66"
                               Margin="12,0,0,0" HorizontalAlignment="Right"
                               VerticalAlignment="Center" TextAlignment="Right"
                               FontSize="11.5" Foreground="{DynamicResource QxTextMutedBrush}"
                               AutomationProperties.LiveSetting="Polite" />

                    <Border Style="{StaticResource PageFilterBox}">
                        <DockPanel>
                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify"
                                                     Width="14" Height="14" Margin="0,0,7,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource QxTextMutedBrush}" />
                            <TextBox x:Name="SearchBox" Style="{StaticResource PageFilterText}"
                                     Tag="Search by name or category"
                                     TextChanged="OnSearch" KeyDown="OnSearchKeyDown"
                                     AutomationProperties.Name="Search scripts"
                                     AutomationProperties.HelpText="Filters saved scripts by name or category" />
                        </DockPanel>
                    </Border>
                </DockPanel>

                <Border Grid.Row="1" Height="1" Margin="12,0"
                        Background="{DynamicResource MaterialDesign.Brush.Divider}" />

                <Grid Grid.Row="2">
                    <ListBox x:Name="List" BorderThickness="0" Background="Transparent" Padding="6,2,6,6"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             IsSynchronizedWithCurrentItem="False"
                             MouseDoubleClick="OnOpen" KeyDown="OnKeyDown"
                             PreviewMouseRightButtonDown="OnItemRightClick"
                             AutomationProperties.Name="Saved scripts"
                             AutomationProperties.HelpText="Press Enter or double-click to open, F2 to rename, Delete to remove">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <!-- The header and the rows are one template rather than a header
                                     template plus an Expander. An ItemsPresenter only finds its
                                     items from inside the template of the ItemsControl that owns
                                     them, which is this GroupItem: nested one level further in, it
                                     has nothing to present and the whole library renders empty. -->
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel>
                                                        <ToggleButton x:Name="head" IsChecked="True"
                                                                      Style="{StaticResource GroupHeaderToggle}"
                                                                      Loaded="OnCategoryLoaded"
                                                                      Checked="OnCategoryExpanded"
                                                                      Unchecked="OnCategoryCollapsed"
                                                                      AutomationProperties.Name="{Binding Name}" />
                                                        <ItemsPresenter x:Name="body" />
                                                    </StackPanel>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger SourceName="head" Property="IsChecked" Value="False">
                                                            <Setter TargetName="body" Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <StackPanel x:Name="EmptyLibrary" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed"
                                AutomationProperties.Name="No saved scripts">
                        <Border Width="48" Height="48" CornerRadius="12"
                                Background="{DynamicResource QxSurfaceSubtleBrush}">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="22" Height="22"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource QxTextMutedBrush}" />
                        </Border>
                        <TextBlock Text="No saved scripts yet" FontSize="13.5" FontWeight="Medium"
                                   HorizontalAlignment="Center" Margin="0,11,0,0"
                                   Foreground="{DynamicResource QxTextSecondaryBrush}" />
                        <TextBlock Text="Create your first script to add it here."
                                   HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource QxTextMutedBrush}" />
                    </StackPanel>

                    <StackPanel x:Name="EmptySearch" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed"
                                AutomationProperties.Name="No matching scripts">
                        <Border Width="48" Height="48" CornerRadius="12"
                                Background="{DynamicResource QxSurfaceSubtleBrush}">
                            <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource QxTextMutedBrush}" />
                        </Border>
                        <TextBlock Text="No matching scripts" FontSize="13.5" FontWeight="Medium"
                                   HorizontalAlignment="Center" Margin="0,11,0,0" Foreground="{DynamicResource QxTextSecondaryBrush}" />
                        <TextBlock x:Name="EmptySearchHint" HorizontalAlignment="Center"
                                   Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource QxTextMutedBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
