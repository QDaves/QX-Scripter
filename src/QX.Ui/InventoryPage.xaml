<local:GamePage x:Class="Qx.Ui.InventoryPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                xmlns:local="clr-namespace:Qx.Ui"
                Background="{DynamicResource MaterialDesign.Brush.Background}">
    <UserControl.Resources>
        <DataTemplate x:Key="ItemIconCell">
            <Grid MinWidth="34" MinHeight="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="{Binding Fallback}" Width="15" Height="15"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="{DynamicResource QxTextMutedBrush}"
                                         Visibility="{Binding HasImage, Converter={StaticResource InvBoolToVis}}" />
                <Image Source="{Binding Image}" Stretch="None"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ItemIdentifierCell">
            <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource FontCode}"
                       FontSize="11.5" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Detail}"
                       Foreground="{DynamicResource QxTextSecondaryBrush}" />
        </DataTemplate>

        <!-- The grid answers "what do I own", so it folds copies into one tile with a count. -->
        <Style x:Key="ItemTile" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="tile" MinWidth="76" MinHeight="76" Margin="3"
                                CornerRadius="{StaticResource RadiusSmall}"
                                BorderThickness="1" Background="Transparent"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                                ToolTip="{Binding Tooltip}">
                            <Grid>
                                <materialDesign:PackIcon Kind="{Binding Fallback}" Width="18" Height="18"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource QxTextMutedBrush}"
                                                         Visibility="{Binding HasImage, Converter={StaticResource InvBoolToVis}}" />
                                <Image Source="{Binding Image}" Stretch="None"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="3" Padding="4,0" CornerRadius="{StaticResource RadiusSmall}"
                                        Background="{DynamicResource QxAccentSoftBrush}"
                                        Visibility="{Binding HasMany, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Trailing}" FontSize="10"
                                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                </Border>
                                <!-- The asking price sits opposite the count, so a shelf of tiles
                                     can be read for what it is worth without opening anything. -->
                                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                        Margin="3" Padding="4,0" CornerRadius="{StaticResource RadiusSmall}"
                                        Background="{DynamicResource QxSurfaceSubtleBrush}"
                                        Visibility="{Binding HasMarket, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding MarketText}" FontSize="9.5"
                                               Foreground="{DynamicResource QxTextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tile" Property="Background"
                                        Value="{DynamicResource QxSurfaceSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tile" Property="Background"
                                        Value="{DynamicResource QxAccentSoftBrush}" />
                                <Setter TargetName="tile" Property="BorderBrush"
                                        Value="{DynamicResource QxAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="TilePanel">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,12">
            <TextBlock Text="Inventory" Style="{StaticResource PageHeading}" />
            <TextBlock x:Name="Subheading" Style="{StaticResource PageSubheading}" />
        </StackPanel>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" CornerRadius="0"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="{StaticResource PageToolbarMargin}">
                    <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="2"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Background="{DynamicResource QxSurfaceSubtleBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="ListToggle" Style="{StaticResource ViewModeToggle}"
                                          MinWidth="40" Click="ShowList" IsChecked="True"
                                          ToolTip="List" AutomationProperties.Name="List view">
                                <materialDesign:PackIcon Kind="ViewListOutline" Width="15" Height="15" />
                            </ToggleButton>
                            <ToggleButton x:Name="GridToggle" Style="{StaticResource ViewModeToggle}"
                                          MinWidth="40" Click="ShowGrid"
                                          ToolTip="Grid" AutomationProperties.Name="Grid view">
                                <materialDesign:PackIcon Kind="ViewGridOutline" Width="15" Height="15" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>
                    <Button DockPanel.Dock="Right" Margin="10,0,0,0"
                            Style="{StaticResource PageActionButton}" Click="Reload"
                            ToolTip="Ask the hotel for the inventory again">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="Reload" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource PageFilterBox}">
                        <DockPanel>
                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,7,0"
                                                     Foreground="{DynamicResource QxTextMutedBrush}" />
                            <TextBox x:Name="Filter" Style="{StaticResource PageFilterText}"
                                     TextChanged="FilterChanged"
                                     Tag="Search your inventory" AutomationProperties.Name="Search your inventory" />
                        </DockPanel>
                    </Border>
                </DockPanel>

                <!-- The filters sit on their own line rather than in the toolbar. Four of them share
                     one question — which of what I own am I looking at — and reading that off a row
                     of controls wedged between the search box and the view switch would mean reading
                     three unrelated things as one. -->
                <Border Grid.Row="1" Margin="12,0,12,8" Padding="11,6,11,4"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Background="{DynamicResource QxSurfaceSubtleBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
                    <WrapPanel Style="{StaticResource SwitchRow}">
                        <TextBlock Text="Show" Style="{StaticResource RowLabel}" />
                        <RadioButton x:Name="KindAny" GroupName="InventoryKind" Content="All"
                                     IsChecked="True" Style="{StaticResource InlineChoice}"
                                     Checked="FilterPicked"
                                     AutomationProperties.Name="Show everything" />
                        <RadioButton x:Name="KindFloor" GroupName="InventoryKind" Content="Floor"
                                     Style="{StaticResource InlineChoice}" Checked="FilterPicked"
                                     AutomationProperties.Name="Show floor furni only" />
                        <RadioButton x:Name="KindWall" GroupName="InventoryKind" Content="Wall"
                                     Style="{StaticResource InlineChoice}" Checked="FilterPicked"
                                     AutomationProperties.Name="Show wall furni only" />
                        <RadioButton x:Name="KindPet" GroupName="InventoryKind" Content="Pets"
                                     Style="{StaticResource InlineChoice}" Checked="FilterPicked"
                                     AutomationProperties.Name="Show pets only" />

                        <Border Style="{StaticResource FilterRule}" />

                        <TextBlock Text="Trade" Style="{StaticResource RowLabel}" />
                        <RadioButton x:Name="TradeAny" GroupName="InventoryTrade" Content="Any"
                                     IsChecked="True" Style="{StaticResource InlineChoice}"
                                     Checked="FilterPicked"
                                     AutomationProperties.Name="Tradeable or not" />
                        <RadioButton x:Name="TradeOpen" GroupName="InventoryTrade" Content="Tradeable"
                                     Style="{StaticResource InlineChoice}" Checked="FilterPicked"
                                     AutomationProperties.Name="Show only what may change hands" />
                        <RadioButton x:Name="TradeLocked" GroupName="InventoryTrade" Content="Locked"
                                     Style="{StaticResource InlineChoice}" Checked="FilterPicked"
                                     AutomationProperties.Name="Show only what may not change hands" />

                        <Border Style="{StaticResource FilterRule}" />

                        <TextBlock Text="Owned" Style="{StaticResource RowLabel}" />
                        <Border Style="{StaticResource InlineNumberBox}">
                            <TextBox x:Name="LeastOwned" Style="{StaticResource InlineNumber}"
                                     Width="38" Tag="any" TextChanged="FilterChanged"
                                     AutomationProperties.Name="Fewest copies to show" />
                        </Border>

                        <TextBlock Text="Price" Style="{StaticResource RowLabel}" />
                        <Border Style="{StaticResource InlineNumberBox}">
                            <TextBox x:Name="LeastPrice" Style="{StaticResource InlineNumber}"
                                     Width="46" Tag="from" TextChanged="FilterChanged"
                                     AutomationProperties.Name="Cheapest price to show" />
                        </Border>
                        <TextBlock Text="to" Style="{StaticResource RowLabel}" />
                        <Border Style="{StaticResource InlineNumberBox}">
                            <TextBox x:Name="MostPrice" Style="{StaticResource InlineNumber}"
                                     Width="46" Tag="up to" TextChanged="FilterChanged"
                                     AutomationProperties.Name="Dearest price to show" />
                        </Border>

                        <Button x:Name="ClearFilters" Style="{StaticResource PageActionButton}"
                                Height="24" Padding="9,0" Margin="2,0,0,0"
                                Visibility="Collapsed" Click="ResetFilters"
                                ToolTip="Put every filter back to showing everything"
                                AutomationProperties.Name="Clear filters">
                            <TextBlock Text="Clear" FontSize="11.5" />
                        </Button>
                    </WrapPanel>
                </Border>

                <DataGrid x:Name="Rows" Grid.Row="2" Style="{StaticResource QxDataGrid}"
                          Margin="4,0,4,0" MinRowHeight="42"
                          ScrollViewer.ScrollChanged="PricesScrolled"
                          PreviewMouseRightButtonDown="RightClickPicks"
                          AutomationProperties.Name="Your inventory">
                    <DataGrid.ContextMenu>
                        <ContextMenu Opened="MenuOpened">
                            <MenuItem x:Name="SellItem" Header="Sell on marketplace" Click="SellSelected">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="TagOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Copy identifier" Click="CopyIdentifier">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentCopy" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Copy item id" Click="CopyItemId">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Identifier" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="Auto" MinWidth="44" CanUserSort="False"
                                                CellStyle="{StaticResource QxIconCell}"
                                                CellTemplate="{StaticResource ItemIconCell}" />
                        <DataGridTextColumn Header="NAME" Width="2*" Binding="{Binding Name}"
                                            ElementStyle="{StaticResource QxDataGridTextElement}" />
                        <DataGridTemplateColumn Header="IDENTIFIER" Width="2*" SortMemberPath="Detail"
                                                CellTemplate="{StaticResource ItemIdentifierCell}" />
                        <DataGridTextColumn Header="KIND" Width="90" Binding="{Binding Group}"
                                            ElementStyle="{StaticResource QxDataGridTextElement}" />
                        <DataGridTextColumn Header="OWNED" Width="80" Binding="{Binding Count}"
                                            ElementStyle="{StaticResource QxDataGridTextElement}" />
                        <!-- Sorted on the number, not on what the cell says. "~120c" and "9c" put
                             next to each other as text order the market backwards. -->
                        <DataGridTextColumn Header="MARKET" Width="110" Binding="{Binding MarketText}"
                                            ElementStyle="{StaticResource QxDataGridTextElement}"
                                            SortMemberPath="MarketValue" />
                        <DataGridTextColumn Header="ITEM ID" Width="*" Binding="{Binding KeyText}" SortMemberPath="Key"
                                            ElementStyle="{StaticResource QxDataGridTextElement}" />
                    </DataGrid.Columns>
                </DataGrid>

                <ListBox x:Name="Tiles" Grid.Row="2" BorderThickness="0" Background="Transparent"
                         Margin="10,0,10,0" Padding="0" Visibility="Collapsed"
                         SelectionMode="Extended"
                         PreviewMouseRightButtonDown="RightClickPicks"
                         ItemContainerStyle="{StaticResource ItemTile}"
                         ItemsPanel="{StaticResource TilePanel}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.ScrollChanged="PricesScrolled"
                         AutomationProperties.Name="Your inventory, by kind">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="MenuOpened">
                            <MenuItem x:Name="SellTile" Header="Sell on marketplace" Click="SellSelected">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="TagOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Copy identifier" Click="CopyIdentifier">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentCopy" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <TextBlock x:Name="Status" Grid.Row="3" Margin="14,8,14,10" FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource QxTextMutedBrush}" />
                <Border x:Name="EmptyNotice" Grid.Row="2" IsHitTestVisible="False"
                                Visibility="Collapsed">
                    <StackPanel Style="{StaticResource PageEmptyNotice}">
                        <materialDesign:PackIcon Kind="PackageVariantClosed" Width="30" Height="30"
                                                 HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyText" FontSize="14" Margin="0,10,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="320" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

    </Grid>
</local:GamePage>
