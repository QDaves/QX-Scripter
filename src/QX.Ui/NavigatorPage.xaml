<local:GamePage x:Class="Qx.Ui.NavigatorPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                xmlns:local="clr-namespace:Qx.Ui"
                Background="{DynamicResource MaterialDesign.Brush.Background}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,12">
            <TextBlock Text="Navigator" Style="{StaticResource PageHeading}" />
            <TextBlock x:Name="Subheading" Style="{StaticResource PageSubheading}" />
        </StackPanel>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" CornerRadius="0"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="{StaticResource PageToolbarMargin}">
                    <Button x:Name="SearchButton" DockPanel.Dock="Right" Margin="10,0,0,0"
                            Style="{StaticResource PageActionButton}" Click="Search"
                            AutomationProperties.Name="Search rooms">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" Width="15" Height="15"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="Search" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="SearchMode" DockPanel.Dock="Left" Width="170" Margin="0,0,10,0"
                              DisplayMemberPath="Label" SelectionChanged="SearchModeChanged"
                              AutomationProperties.Name="Navigator search type" />
                    <Border Style="{StaticResource PageFilterBox}">
                        <DockPanel>
                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,7,0"
                                                     Foreground="{DynamicResource QxTextMutedBrush}" />
                            <TextBox x:Name="Query" Style="{StaticResource PageFilterText}"
                                     KeyDown="QueryKeyDown" Tag="Search rooms"
                                     AutomationProperties.Name="Navigator search text" />
                        </DockPanel>
                    </Border>
                </DockPanel>

                <DataGrid x:Name="Rooms" Grid.Row="1" Style="{StaticResource QxDataGrid}"
                          Margin="4,0,4,0" SelectionMode="Single"
                          PreviewMouseLeftButtonUp="CopyRoomValue"
                          MouseDoubleClick="EnterRoom"
                          AutomationProperties.Name="Navigator rooms">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ROOM" Width="2*" Binding="{Binding Name}"
                                            ElementStyle="{StaticResource QxDataGridTextElement}" />
                        <DataGridTextColumn Header="OWNER" Width="1.5*" Binding="{Binding OwnerName}"
                                            ElementStyle="{StaticResource QxDataGridTextElement}" />
                        <DataGridTextColumn Header="USERS" Width="75" Binding="{Binding UserCount}"
                                            ElementStyle="{StaticResource QxDataGridTextElement}" />
                        <DataGridTextColumn Header="CAPACITY" Width="85" Binding="{Binding MaxUserCount}"
                                            ElementStyle="{StaticResource QxDataGridTextElement}" />
                        <DataGridTextColumn Header="SCORE" Width="75" Binding="{Binding Score}"
                                            ElementStyle="{StaticResource QxDataGridTextElement}" />
                        <DataGridTextColumn Header="ID" Width="*" Binding="{Binding Id}"
                                            ElementStyle="{StaticResource QxDataGridTextElement}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="Status" Grid.Row="2" Margin="14,8,14,10" FontSize="11"
                           TextWrapping="Wrap" Foreground="{DynamicResource QxTextMutedBrush}" />

                <Border x:Name="EmptyNotice" Grid.Row="1" IsHitTestVisible="False">
                    <StackPanel Style="{StaticResource PageEmptyNotice}">
                        <materialDesign:PackIcon Kind="CompassOutline" Width="30" Height="30"
                                                 HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyText" Text="Choose a search to find rooms."
                                   FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</local:GamePage>
