<UserControl x:Class="Qx.Ui.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesign.Brush.Background}">
    <UserControl.Resources>
        <Style x:Key="PanelGroupHeader" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="13,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <materialDesign:PackIcon x:Name="chevron"
                                                         DockPanel.Dock="Left"
                                                         Kind="ChevronDown"
                                                         Width="17" Height="17"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         RenderTransformOrigin="0.5,0.5"
                                                         Foreground="{DynamicResource QxTextMutedBrush}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="surface" Property="Background"
                                        Value="{DynamicResource QxSurfaceSubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      Padding="0,0,4,0">
            <!-- The middle column takes everything it can up to 680 and the two hairline columns
                 split whatever is left, which centres the form without pinning it to a fixed width. -->
            <Grid Margin="24,26,24,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="400*" MaxWidth="680" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="FormPanel" Grid.Column="1" HorizontalAlignment="Stretch" />
            </Grid>
        </ScrollViewer>

        <!-- Messages sit above the form rather than in it, so one arriving does not move what the
             user is reading or typing into. Nothing here can be hit or focused: a message that
             takes the caret out of a field, or swallows a click meant for the scrollbar behind it,
             is worse than no message at all. -->
        <StackPanel x:Name="ToastHost"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="16,0,20,18"
                    Focusable="False"
                    IsHitTestVisible="False" />
    </Grid>
</UserControl>
