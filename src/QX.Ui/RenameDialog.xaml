<Window x:Class="Qx.Ui.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Rename script" SizeToContent="Height" Width="380"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontFamily="{StaticResource FontUI}" TextElement.FontSize="13"
        ShowInTaskbar="False" UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="20,11,10,11">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon x:Name="HeaderIcon" Kind="RenameBox" Width="20" Height="20"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource QxAccentBrush}" />
                        <TextBlock x:Name="TitleText" Text="Rename script" FontSize="16" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="32" Height="32" Padding="0"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Click="OnCancel" ToolTip="Close"
                            AutomationProperties.Name="Close rename dialog">
                        <materialDesign:PackIcon Kind="Close" Width="17" Height="17" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,18,20,20">
                <TextBox x:Name="NameBox" materialDesign:HintAssist.Hint="Script name"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         TextChanged="OnNameChanged"
                         AutomationProperties.Name="Script name" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Cancel" Style="{StaticResource MaterialDesignFlatButton}"
                            Click="OnCancel" Margin="0,0,8,0" IsCancel="True"
                            AutomationProperties.Name="Cancel" />
                    <Button x:Name="RenameButton" Content="Rename"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="OnOk" IsDefault="True"
                            AutomationProperties.Name="Rename script" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
