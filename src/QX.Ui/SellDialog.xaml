<Window x:Class="Qx.Ui.SellDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Sell on marketplace" SizeToContent="Height" Width="760" MaxHeight="720"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontFamily="{StaticResource FontUI}" TextElement.FontSize="13"
        ShowInTaskbar="False" UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="20,11,10,11">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="TagOutline" Width="20" Height="20"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource QxAccentBrush}" />
                        <TextBlock Text="Sell on marketplace" FontSize="16" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="32" Height="32" Padding="0"
                            Style="{StaticResource PageActionButton}" Click="OnCancel"
                            ToolTip="Close">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                    </Button>
                </Grid>
            </Border>

            <!-- What to ask. A price is set once here and applied to every kind, because the whole
                 reason to select twelve things is not to type twelve numbers. Undercutting takes the
                 standing price and steps under it; the hotel will not take an offer below two, so
                 that is where the step stops rather than being refused after the fact. -->
            <Border Grid.Row="1" Padding="20,14,20,14" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
                <StackPanel>
                    <WrapPanel>
                        <RadioButton x:Name="ModeSuggested" GroupName="mode" IsChecked="True"
                                     Content="Market price" VerticalAlignment="Center"
                                     Checked="OnModeChanged" />
                        <RadioButton x:Name="ModeUndercut" GroupName="mode" Margin="18,0,0,0"
                                     Content="Undercut by" VerticalAlignment="Center"
                                     Checked="OnModeChanged" />
                        <Border Style="{StaticResource PageFilterBox}" Width="64" Margin="8,0,0,0">
                            <TextBox x:Name="UndercutBy" Style="{StaticResource PageFilterText}"
                                     Text="1" TextChanged="OnPricingChanged"
                                     AutomationProperties.Name="Undercut amount" />
                        </Border>
                        <RadioButton x:Name="ModeFixed" GroupName="mode" Margin="18,0,0,0"
                                     Content="Fixed" VerticalAlignment="Center"
                                     Checked="OnModeChanged" />
                        <Border Style="{StaticResource PageFilterBox}" Width="84" Margin="8,0,0,0">
                            <TextBox x:Name="FixedPrice" Style="{StaticResource PageFilterText}"
                                     Text="" TextChanged="OnPricingChanged"
                                     AutomationProperties.Name="Fixed price" />
                        </Border>
                    </WrapPanel>

                    <!-- Kinds the market has never priced cannot be undercut, because there is
                         nothing to undercut. They are named rather than silently skipped, and a
                         price typed here is what they go out at. -->
                    <DockPanel x:Name="UnpricedRow" Margin="0,12,0,0" Visibility="Collapsed">
                        <Border Style="{StaticResource PageFilterBox}" Width="84"
                                DockPanel.Dock="Right" Margin="8,0,0,0">
                            <TextBox x:Name="UnpricedPrice" Style="{StaticResource PageFilterText}"
                                     Text="" TextChanged="OnPricingChanged"
                                     AutomationProperties.Name="Price for unpriced kinds" />
                        </Border>
                        <TextBlock x:Name="UnpricedNote" VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource QxTextMutedBrush}" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <DataGrid x:Name="Rows" Grid.Row="2" Style="{StaticResource QxDataGrid}"
                      Margin="20,12,20,12" AutoGenerateColumns="False" CanUserSortColumns="False"
                      HeadersVisibility="Column" RowHeight="34" IsReadOnly="False"
                      CellStyle="{StaticResource QxDataGridCell}"
                      RowStyle="{StaticResource QxDataGridRow}"
                      ColumnHeaderStyle="{StaticResource QxDataGridHeader}"
                      CellEditEnding="OnCellEdited">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ITEM" Width="2*" IsReadOnly="True"
                                        Binding="{Binding Name}"
                                        ElementStyle="{StaticResource QxDataGridTextElement}" />
                    <DataGridTextColumn Header="OWNED" Width="80" IsReadOnly="True"
                                        Binding="{Binding Owned}"
                                        ElementStyle="{StaticResource QxDataGridTextElement}" />
                    <DataGridTextColumn Header="MARKET" Width="110" IsReadOnly="True"
                                        Binding="{Binding MarketText}"
                                        ElementStyle="{StaticResource QxDataGridTextElement}" />
                    <DataGridTemplateColumn Header="SELL" Width="104" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="26" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="−" Width="24" Height="24"
                                            MinWidth="0" MinHeight="0" Padding="0"
                                            Style="{StaticResource PageActionButton}"
                                            CommandParameter="{Binding}" Click="DecreaseAmount"
                                            AutomationProperties.Name="Sell one fewer" />
                                    <TextBlock Grid.Column="1" Text="{Binding Amount}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="+" Width="24" Height="24"
                                            MinWidth="0" MinHeight="0" Padding="0"
                                            Style="{StaticResource PageActionButton}"
                                            CommandParameter="{Binding}" Click="IncreaseAmount"
                                            AutomationProperties.Name="Sell one more" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PRICE" Width="90"
                                        Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource QxDataGridTextElement}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3" Padding="20,12,20,14" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Cancel" Style="{StaticResource PageActionButton}"
                                MinWidth="88" Click="OnCancel" />
                        <Button x:Name="SellButton" Content="Sell" Margin="8,0,0,0"
                                Style="{StaticResource PageActionButton}" MinWidth="88"
                                Click="OnSell" />
                    </StackPanel>
                    <TextBlock x:Name="Summary" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource QxTextSecondaryBrush}" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
