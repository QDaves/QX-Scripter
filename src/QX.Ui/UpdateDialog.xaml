<Window x:Class="Qx.Ui.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Update available" SizeToContent="Height" Width="520"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontFamily="{StaticResource FontUI}" TextElement.FontSize="13"
        ShowInTaskbar="False" UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border BorderThickness="1" BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid Margin="20,11,10,11">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Update" Width="20" Height="20"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource QxAccentBrush}" />
                        <TextBlock Text="Update available" FontSize="16" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Width="32" Height="32" Padding="0"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Click="OnLater" ToolTip="Close"
                            AutomationProperties.Name="Close update notice">
                        <materialDesign:PackIcon Kind="Close" Width="17" Height="17" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,22,24,20">
                <TextBlock Text="A newer QX Scripter release is ready."
                           FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="ReleaseNameText" Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource QxTextSecondaryBrush}" />

                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="INSTALLED" FontSize="10"
                                   Foreground="{DynamicResource QxTextMutedBrush}" />
                        <TextBlock x:Name="InstalledVersionText" Margin="0,4,0,0"
                                   FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <materialDesign:PackIcon Grid.Column="1" Kind="ArrowRight" Width="19" Height="19"
                                             Margin="22,18" VerticalAlignment="Center"
                                             Foreground="{DynamicResource QxTextMutedBrush}" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="AVAILABLE" FontSize="10"
                                   Foreground="{DynamicResource QxTextMutedBrush}" />
                        <TextBlock x:Name="AvailableVersionText" Margin="0,4,0,0"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource QxAccentBrush}" />
                    </StackPanel>
                </Grid>

                <TextBlock Margin="0,22,0,0"
                           Text="GitHub has the release notes and download."
                           Foreground="{DynamicResource QxTextSecondaryBrush}" />

                <TextBlock x:Name="ErrorText" Margin="0,10,0,0" Visibility="Collapsed"
                           TextWrapping="Wrap" Foreground="{DynamicResource QxDangerBrush}"
                           AutomationProperties.LiveSetting="Assertive" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Content="Later" Style="{StaticResource MaterialDesignFlatButton}"
                            Click="OnLater" Margin="0,0,8,0" IsCancel="True"
                            AutomationProperties.Name="Close update notice" />
                    <Button x:Name="OpenButton" Content="View on GitHub"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="OnOpen" IsDefault="True"
                            AutomationProperties.Name="View release on GitHub" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
