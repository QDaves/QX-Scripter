<local:GamePage x:Class="Qx.Ui.WardrobePage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                xmlns:local="clr-namespace:Qx.Ui"
                Background="{DynamicResource MaterialDesign.Brush.Background}">
    <UserControl.Resources>
        <!-- A tile is the whole figure, big enough to see what the outfit actually is. The turn and
             wear buttons appear on hover so a shelf of outfits is a shelf of outfits, not a shelf
             of buttons. -->
        <Style x:Key="OutfitTileItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="tile" Width="120" Height="150" Margin="4"
                                CornerRadius="{StaticResource RadiusMedium}"
                                BorderThickness="1" Background="Transparent"
                                BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
                            <Grid>
                                <TextBlock Text="…" FontSize="20" Opacity="0.3"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasImage, Converter={StaticResource InvBoolToVis}}" />
                                <!-- Drawn at the size the hotel sent it. Scaling a figure render up
                                     to fill a tile is what made them soft; the whole point of the
                                     large render is that it is already the right size. -->
                                <Image Source="{Binding Image}" Stretch="None"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       ToolTip="{Binding Figure}" />

                                <StackPanel x:Name="acts" Orientation="Horizontal" Opacity="0"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                            Margin="0,0,0,24">
                                    <Button Style="{StaticResource TileIconButton}"
                                            Click="TurnLeft" Tag="{Binding}" ToolTip="Turn left">
                                        <materialDesign:PackIcon Kind="RotateLeft" Width="14" Height="14" />
                                    </Button>
                                    <Button Style="{StaticResource TileIconButton}"
                                            Click="WearOutfit" Tag="{Binding}" ToolTip="Wear this">
                                        <materialDesign:PackIcon Kind="TshirtCrewOutline" Width="14" Height="14" />
                                    </Button>
                                    <Button Style="{StaticResource TileIconButton}"
                                            Click="TurnRight" Tag="{Binding}" ToolTip="Turn right">
                                        <materialDesign:PackIcon Kind="RotateRight" Width="14" Height="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tile" Property="Background"
                                        Value="{DynamicResource QxSurfaceSubtleBrush}" />
                                <Setter TargetName="acts" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tile" Property="Background"
                                        Value="{DynamicResource QxAccentSoftBrush}" />
                                <Setter TargetName="tile" Property="BorderBrush"
                                        Value="{DynamicResource QxAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="TilePanel">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,12">
            <TextBlock Text="Wardrobe" Style="{StaticResource PageHeading}" />
            <TextBlock x:Name="Subheading" Style="{StaticResource PageSubheading}" />
        </StackPanel>

        <Border Grid.Row="1" BorderThickness="0,1,0,0" CornerRadius="0"
                BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="{StaticResource PageToolbarMargin}">
                    <Button x:Name="RemoveButton" DockPanel.Dock="Right" Margin="8,0,0,0"
                            Style="{StaticResource PageActionButton}" Click="RemoveSelected"
                            IsEnabled="False" ToolTip="Delete the selected outfits">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="15" Height="15"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="Delete" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                            Style="{StaticResource PageActionButton}" Click="ImportWardrobe"
                            ToolTip="Copy the ten slots the hotel keeps into this shelf">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Import" Width="15" Height="15"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="Import in-game" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Margin="10,0,0,0"
                            Style="{StaticResource PageActionButton}" Click="AddCurrentFigure"
                            ToolTip="Keep what you are wearing right now">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="15" Height="15"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="Add current" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource PageFilterBox}">
                        <DockPanel>
                            <materialDesign:PackIcon DockPanel.Dock="Left" Kind="Magnify" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,7,0"
                                                     Foreground="{DynamicResource QxTextMutedBrush}" />
                            <TextBox x:Name="Filter" Style="{StaticResource PageFilterText}"
                                     TextChanged="FilterChanged"
                                     Tag="Search your outfits" AutomationProperties.Name="Search your outfits" />
                        </DockPanel>
                    </Border>
                </DockPanel>

                <ListBox x:Name="Rows" Grid.Row="1" BorderThickness="0" Background="Transparent"
                         Margin="8,0,8,0" Padding="0" SelectionMode="Extended"
                         SelectionChanged="SelectionChanged"
                         ItemContainerStyle="{StaticResource OutfitTileItem}"
                         ItemsPanel="{StaticResource TilePanel}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Your saved outfits">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Wear" Click="WearSelected">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="TshirtCrewOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Copy figure" Click="CopyFigure">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="ContentCopy" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Delete" Click="RemoveSelected">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="TrashCanOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <TextBlock x:Name="Status" Grid.Row="2" Margin="14,8,14,10" FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource QxTextMutedBrush}" />
        <Border x:Name="EmptyNotice" Grid.Row="1" IsHitTestVisible="False"
                                Visibility="Collapsed">
                    <StackPanel Style="{StaticResource PageEmptyNotice}">
                        <materialDesign:PackIcon Kind="Hanger" Width="30" Height="30" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyText" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

    </Grid>
</local:GamePage>
